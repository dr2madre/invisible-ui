{
  "name": "@nozcadesign/invisible-ui-vue",
  "version": "0.1.0-alpha.1",
  "description": "Vue 3 adapter for the design system: thin, headless, accessible bindings over @nozcadesign/invisible-ui-core.",
  "author": "nozcadesign",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dr2madre/invisible-ui.git",
    "directory": "packages/vue"
  },
  "homepage": "https://invisibleui.de/",
  "bugs": {
    "url": "https://github.com/dr2madre/invisible-ui/issues"
  },
  "keywords": [
    "accessibility",
    "components",
    "design-system",
    "vue"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "src/styles"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./src/styles/index.css",
    "./tokens.css": "./src/styles/tokens.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node ../../scripts/write-build-info.mjs packages/vue && tsup && node ../../scripts/write-build-info.mjs packages/vue --verify",
    "smoke": "node scripts/smoke-package.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.tests.json"
  },
  "peerDependencies": {
    "vue": "^3.4.0"
  },
  "dependencies": {
    "@nozcadesign/invisible-ui-core": "workspace:*",
    "@floating-ui/dom": "^1.7.6"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/user-event": "^14.6.1",
    "@testing-library/vue": "^8.1.0",
    "@vue/server-renderer": "^3.5.43",
    "jsdom": "^29.1.1",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vite": "^6.4.3",
    "vitest": "^4.1.11",
    "vitest-axe": "^0.1.0",
    "vue": "^3.5.43"
  }
}
