{
  "component": "stepper",
  "selected": false,
  "frameworks": {
    "svelte": {
      "import": {
        "kind": "default",
        "name": "Stepper",
        "specifier": "@design-system/svelte/Stepper.svelte"
      },
      "props": [
        {
          "name": "steps",
          "type": "StepDescriptor[]",
          "default": null,
          "required": true,
          "description": "",
          "descriptionFrom": "none"
        },
        {
          "name": "current",
          "type": "number",
          "default": "0",
          "required": false,
          "description": "",
          "descriptionFrom": "none"
        },
        {
          "name": "linear",
          "type": "boolean",
          "default": "true",
          "required": false,
          "description": "",
          "descriptionFrom": "none"
        },
        {
          "name": "orientation",
          "type": "\"horizontal\" | \"vertical\"",
          "default": "\"horizontal\"",
          "required": false,
          "description": "",
          "descriptionFrom": "none"
        },
        {
          "name": "disabled",
          "type": "boolean",
          "default": "false",
          "required": false,
          "description": "",
          "descriptionFrom": "none"
        },
        {
          "name": "label",
          "type": "string | undefined",
          "default": "undefined",
          "required": false,
          "description": "Accessible name.",
          "descriptionFrom": "curated"
        },
        {
          "name": "onStepChange",
          "type": "((current: number) => void) | undefined",
          "default": "undefined",
          "required": false,
          "description": "Called when the active step changes.",
          "descriptionFrom": "curated"
        }
      ]
    },
    "vue": {
      "import": {
        "kind": "named",
        "name": "Stepper",
        "specifier": "@design-system/vue"
      },
      "props": [
        {
          "name": "steps",
          "type": "StepDescriptor[]",
          "default": null,
          "required": true,
          "description": "",
          "descriptionFrom": "none"
        },
        {
          "name": "current",
          "type": "number",
          "default": "0",
          "required": false,
          "description": "Current step (0-based); bindable with `v-model:current`.",
          "descriptionFrom": "source"
        },
        {
          "name": "linear",
          "type": "boolean",
          "default": "true",
          "required": false,
          "description": "",
          "descriptionFrom": "none"
        },
        {
          "name": "orientation",
          "type": "StepperOrientation",
          "default": "\"horizontal\"",
          "required": false,
          "description": "",
          "descriptionFrom": "none"
        },
        {
          "name": "disabled",
          "type": "boolean",
          "default": "false",
          "required": false,
          "description": "",
          "descriptionFrom": "none"
        },
        {
          "name": "label",
          "type": "string",
          "default": "undefined",
          "required": false,
          "description": "Accessible name for the progress nav. Defaults to the catalog's \"Progress\".",
          "descriptionFrom": "source"
        },
        {
          "name": "onStepChange",
          "type": "(current: number) => void",
          "default": "undefined",
          "required": false,
          "description": "Called whenever the current step changes.",
          "descriptionFrom": "source"
        }
      ],
      "emits": [
        {
          "name": "update:current",
          "payload": "current: number"
        }
      ],
      "slots": []
    },
    "elements": {
      "import": {
        "kind": "element",
        "name": "ds-stepper",
        "specifier": "@design-system/elements/define"
      },
      "attributes": [
        {
          "name": "current",
          "reactive": true,
          "required": false,
          "description": "0-based step, `0` by default",
          "descriptionFrom": "source"
        },
        {
          "name": "linear",
          "reactive": true,
          "required": false,
          "description": "on by default, `\"false\"` turns it off",
          "descriptionFrom": "source"
        },
        {
          "name": "orientation",
          "reactive": true,
          "required": false,
          "description": "`horizontal` or `vertical`",
          "descriptionFrom": "source"
        },
        {
          "name": "disabled",
          "reactive": true,
          "required": false,
          "description": "",
          "descriptionFrom": "none"
        },
        {
          "name": "label",
          "reactive": true,
          "required": false,
          "description": "the landmark name",
          "descriptionFrom": "source"
        },
        {
          "name": "completed-label",
          "reactive": true,
          "required": false,
          "description": "the status read for a completed step",
          "descriptionFrom": "source"
        }
      ],
      "notes": [
        "Properties: `steps` (each with a `label` and an optional `description`), `current`.",
        "Emits: `change` (`detail.current`) after the user picks a step."
      ]
    }
  }
}
