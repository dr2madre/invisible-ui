{
  "component": "date-range-picker",
  "selected": false,
  "frameworks": {
    "svelte": {
      "import": {
        "kind": "default",
        "name": "DateRangePicker",
        "specifier": "@design-system/svelte/DateRangePicker.svelte"
      },
      "props": [
        {
          "name": "start",
          "type": "string | null",
          "default": "null",
          "required": false,
          "description": ""
        },
        {
          "name": "end",
          "type": "string | null",
          "default": "null",
          "required": false,
          "description": ""
        },
        {
          "name": "min",
          "type": "string | undefined",
          "default": "undefined",
          "required": false,
          "description": ""
        },
        {
          "name": "max",
          "type": "string | undefined",
          "default": "undefined",
          "required": false,
          "description": ""
        },
        {
          "name": "weekStartsOn",
          "type": "WeekStart",
          "default": "1",
          "required": false,
          "description": ""
        },
        {
          "name": "locale",
          "type": "string | undefined",
          "default": "undefined",
          "required": false,
          "description": ""
        },
        {
          "name": "dateStyle",
          "type": "\"full\" | \"long\" | \"medium\" | \"short\"",
          "default": "\"medium\"",
          "required": false,
          "description": ""
        },
        {
          "name": "view",
          "type": "CalendarView",
          "default": "\"two-month\"",
          "required": false,
          "description": "Calendar view inside the popover."
        },
        {
          "name": "label",
          "type": "string | undefined",
          "default": "undefined",
          "required": false,
          "description": "Accessible label."
        },
        {
          "name": "placeholder",
          "type": "string | undefined",
          "default": "undefined",
          "required": false,
          "description": "Shown when empty."
        },
        {
          "name": "disabled",
          "type": "boolean",
          "default": "false",
          "required": false,
          "description": "Disable the field."
        },
        {
          "name": "clearable",
          "type": "boolean",
          "default": "false",
          "required": false,
          "description": "Show a clear button when a range is set."
        },
        {
          "name": "events",
          "type": "CalendarEvent[]",
          "default": "[]",
          "required": false,
          "description": "Forwarded to the calendar."
        },
        {
          "name": "prices",
          "type": "Record<string, string>",
          "default": "{}",
          "required": false,
          "description": "Forwarded to the calendar."
        },
        {
          "name": "startName",
          "type": "string | undefined",
          "default": "undefined",
          "required": false,
          "description": "Form field names — the start/end ISO dates are submitted under them (via hidden inputs)."
        },
        {
          "name": "endName",
          "type": "string | undefined",
          "default": "undefined",
          "required": false,
          "description": "Form field names — the start/end ISO dates are submitted under them (via hidden inputs)."
        },
        {
          "name": "onChange",
          "type": "((start: string | null, end: string | null) => void) | undefined",
          "default": "undefined",
          "required": false,
          "description": "Called when the range changes."
        }
      ]
    },
    "vue": {
      "import": {
        "kind": "named",
        "name": "DateRangePicker",
        "specifier": "@design-system/vue"
      },
      "props": [
        {
          "name": "start",
          "type": "string | null",
          "default": "null",
          "required": false,
          "description": "Range start (ISO `YYYY-MM-DD`), or `null`."
        },
        {
          "name": "end",
          "type": "string | null",
          "default": "null",
          "required": false,
          "description": "Range end (ISO `YYYY-MM-DD`), or `null`."
        },
        {
          "name": "min",
          "type": "string",
          "default": "undefined",
          "required": false,
          "description": ""
        },
        {
          "name": "max",
          "type": "string",
          "default": "undefined",
          "required": false,
          "description": ""
        },
        {
          "name": "weekStartsOn",
          "type": "WeekStart",
          "default": "1",
          "required": false,
          "description": ""
        },
        {
          "name": "locale",
          "type": "string",
          "default": "undefined",
          "required": false,
          "description": ""
        },
        {
          "name": "dateStyle",
          "type": "DateStyle",
          "default": "\"medium\"",
          "required": false,
          "description": ""
        },
        {
          "name": "view",
          "type": "CalendarView",
          "default": "\"two-month\"",
          "required": false,
          "description": "Calendar view inside the popover. Defaults to two months side by side."
        },
        {
          "name": "label",
          "type": "string",
          "default": "undefined",
          "required": false,
          "description": ""
        },
        {
          "name": "placeholder",
          "type": "string",
          "default": "undefined",
          "required": false,
          "description": ""
        },
        {
          "name": "disabled",
          "type": "boolean",
          "default": "false",
          "required": false,
          "description": ""
        },
        {
          "name": "clearable",
          "type": "boolean",
          "default": "false",
          "required": false,
          "description": ""
        },
        {
          "name": "events",
          "type": "CalendarEvent[]",
          "default": "() => []",
          "required": false,
          "description": ""
        },
        {
          "name": "prices",
          "type": "Record<string, string>",
          "default": "() => ({})",
          "required": false,
          "description": ""
        },
        {
          "name": "startName",
          "type": "string",
          "default": "undefined",
          "required": false,
          "description": "Form field name for the start date, submitted as an ISO value."
        },
        {
          "name": "endName",
          "type": "string",
          "default": "undefined",
          "required": false,
          "description": "Form field name for the end date, submitted as an ISO value."
        },
        {
          "name": "onChange",
          "type": "(start: string | null, end: string | null) => void",
          "default": "undefined",
          "required": false,
          "description": ""
        }
      ],
      "emits": [
        {
          "name": "update:start",
          "payload": "value: string | null"
        },
        {
          "name": "update:end",
          "payload": "value: string | null"
        }
      ],
      "slots": []
    }
  }
}
