{
  "component": "context-menu",
  "selected": false,
  "frameworks": {
    "svelte": {
      "import": {
        "kind": "default",
        "name": "ContextMenu",
        "specifier": "@design-system/svelte/ContextMenu.svelte"
      },
      "props": [
        {
          "name": "items",
          "type": "MenuItem[]",
          "default": null,
          "required": true,
          "description": "",
          "descriptionFrom": "none"
        },
        {
          "name": "disabled",
          "type": "boolean",
          "default": "false",
          "required": false,
          "description": "",
          "descriptionFrom": "none"
        },
        {
          "name": "onSelect",
          "type": "((value: string) => void) | undefined",
          "default": "undefined",
          "required": false,
          "description": "Called with the chosen item's value.",
          "descriptionFrom": "source"
        },
        {
          "name": "label",
          "type": "string | undefined",
          "default": "undefined",
          "required": false,
          "description": "Accessible name for the popup (there is no labelling trigger).",
          "descriptionFrom": "curated"
        }
      ]
    },
    "vue": {
      "import": {
        "kind": "named",
        "name": "ContextMenu",
        "specifier": "@design-system/vue"
      },
      "props": [
        {
          "name": "items",
          "type": "MenuItem[]",
          "default": null,
          "required": true,
          "description": "",
          "descriptionFrom": "none"
        },
        {
          "name": "disabled",
          "type": "boolean",
          "default": "false",
          "required": false,
          "description": "",
          "descriptionFrom": "none"
        },
        {
          "name": "onSelect",
          "type": "(value: string) => void",
          "default": "undefined",
          "required": false,
          "description": "Called with the chosen item's value.",
          "descriptionFrom": "source"
        },
        {
          "name": "label",
          "type": "string",
          "default": "undefined",
          "required": false,
          "description": "Accessible name for the popup; no trigger labels it. Defaults to the catalog's \"Context menu\".",
          "descriptionFrom": "source"
        }
      ],
      "emits": [],
      "slots": [
        "default"
      ]
    },
    "elements": {
      "import": {
        "kind": "element",
        "name": "ds-context-menu",
        "specifier": "@design-system/elements/define"
      },
      "attributes": [
        {
          "name": "label",
          "reactive": true,
          "required": false,
          "description": "",
          "descriptionFrom": "none"
        },
        {
          "name": "disabled",
          "reactive": true,
          "required": false,
          "description": "",
          "descriptionFrom": "none"
        }
      ],
      "notes": [
        "Properties: `items` (`ContextMenuItem[]`: `{ value, label?, disabled? }`).",
        "Emits: bubbling `select` CustomEvent with `detail.value`, after the menu closes."
      ]
    }
  }
}
