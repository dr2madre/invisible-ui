{
  "component": "select",
  "selected": false,
  "frameworks": {
    "svelte": {
      "import": {
        "kind": "default",
        "name": "Select",
        "specifier": "@design-system/svelte/Select.svelte"
      },
      "props": [
        {
          "name": "label",
          "type": "string",
          "default": null,
          "required": true,
          "description": "Accessible name for the control.",
          "descriptionFrom": "source"
        },
        {
          "name": "hideLabel",
          "type": "boolean",
          "default": "false",
          "required": false,
          "description": "Visually hide the label (kept for assistive tech) — for compact toolbars.",
          "descriptionFrom": "source"
        },
        {
          "name": "items",
          "type": "SelectItem[]",
          "default": null,
          "required": true,
          "description": "Options (`{ value, label?, disabled? }`); `label` falls back to `value`.",
          "descriptionFrom": "curated"
        },
        {
          "name": "value",
          "type": "string | null",
          "default": "null",
          "required": false,
          "description": "Selected value.",
          "descriptionFrom": "curated"
        },
        {
          "name": "placeholder",
          "type": "string | undefined",
          "default": "undefined",
          "required": false,
          "description": "Trigger text when nothing is selected.",
          "descriptionFrom": "curated"
        },
        {
          "name": "disabled",
          "type": "boolean",
          "default": "false",
          "required": false,
          "description": "Disable the control.",
          "descriptionFrom": "curated"
        },
        {
          "name": "width",
          "type": "\"wrap\" | \"fill\" | \"fixed\"",
          "default": "\"wrap\"",
          "required": false,
          "description": "Width behaviour: `wrap` fits the longest option (plus the trigger padding), `fill` takes 100% of the container, `fixed` uses `--ds-select-width` (16rem by default).",
          "descriptionFrom": "curated"
        },
        {
          "name": "name",
          "type": "string | undefined",
          "default": "undefined",
          "required": false,
          "description": "Form field name — the selected value is submitted under it (via a hidden input).",
          "descriptionFrom": "curated"
        },
        {
          "name": "required",
          "type": "boolean",
          "default": "false",
          "required": false,
          "description": "Marks the control as required (announced to assistive tech).",
          "descriptionFrom": "curated"
        },
        {
          "name": "error",
          "type": "string | undefined",
          "default": "undefined",
          "required": false,
          "description": "Error message; when non-empty the select becomes invalid and announces it.",
          "descriptionFrom": "source"
        },
        {
          "name": "onValueChange",
          "type": "((value: string) => void) | undefined",
          "default": "undefined",
          "required": false,
          "description": "Called whenever the selected value changes.",
          "descriptionFrom": "source"
        }
      ]
    },
