{
  "component": "search-dialog",
  "selected": false,
  "frameworks": {
    "svelte": {
      "import": {
        "kind": "default",
        "name": "SearchDialog",
        "specifier": "@design-system/svelte/SearchDialog.svelte"
      },
      "props": [
        {
          "name": "triggerVariant",
          "type": "\"default\" | \"primary\" | \"secondary\" | \"ghost\" | \"danger\"",
          "default": "\"default\"",
          "required": false,
          "description": "Visual variant for the trigger Button.",
          "descriptionFrom": "source"
        },
        {
          "name": "items",
          "type": "SearchDialogItem[]",
          "default": null,
          "required": true,
          "description": "",
          "descriptionFrom": "none"
        },
        {
          "name": "suggestions",
          "type": "SearchDialogItem[]",
          "default": "[]",
          "required": false,
          "description": "Items shown while the query is empty — recents, frequent searches. The application measures and decides; the dialog displays. They may carry their own `group` (\"Recent\"). Empty means: an empty query shows all items.",
          "descriptionFrom": "source"
        },
        {
          "name": "loading",
          "type": "boolean",
          "default": "false",
          "required": false,
          "description": "Results are being fetched: shows an indicator, announces \"Searching…\" through the status region and suppresses the empty state meanwhile. Feed async results through `items` when they arrive.",
          "descriptionFrom": "source"
        },
        {
          "name": "open",
          "type": "boolean",
          "default": "false",
          "required": false,
          "description": "",
          "descriptionFrom": "none"
        },
        {
          "name": "title",
          "type": "string | undefined",
          "default": "undefined",
          "required": false,
          "description": "Accessible title for the dialog. Defaults to the i18n catalog's \"Search\".",
          "descriptionFrom": "source"
        },
        {
          "name": "label",
          "type": "string | undefined",
          "default": "undefined",
          "required": false,
          "description": "Accessible label for the search input. Defaults to the i18n catalog's \"Search\".",
          "descriptionFrom": "source"
        },
        {
          "name": "placeholder",
          "type": "string | undefined",
          "default": "undefined",
          "required": false,
          "description": "Input placeholder. Defaults to the i18n catalog's \"Type to search…\".",
          "descriptionFrom": "source"
        },
        {
          "name": "emptyText",
          "type": "string | undefined",
          "default": "undefined",
          "required": false,
          "description": "Text shown when nothing matches. Defaults to the i18n catalog's \"No results found.\".",
          "descriptionFrom": "source"
        },
        {
          "name": "onSelect",
          "type": "((value: string) => void) | undefined",
          "default": "undefined",
          "required": false,
          "description": "",
          "descriptionFrom": "none"
        },
        {
          "name": "onOpenChange",
          "type": "((o: boolean) => void) | undefined",
          "default": "undefined",
          "required": false,
          "description": "",
          "descriptionFrom": "none"
        }
      ]
    },
    "vue": {
      "import": {
        "kind": "named",
        "name": "SearchDialog",
        "specifier": "@design-system/vue"
      },
      "props": [
        {
          "name": "triggerVariant",
          "type": "ButtonVariant",
          "default": "\"default\"",
          "required": false,
          "description": "Visual variant for the trigger Button.",
          "descriptionFrom": "source"
        },
        {
          "name": "trigger",
          "type": "string",
          "default": "undefined",
          "required": false,
          "description": "The trigger button's label. The `trigger` slot replaces it with markup.",
          "descriptionFrom": "source"
        },
        {
          "name": "items",
          "type": "SearchDialogItem[]",
          "default": null,
          "required": true,
          "description": "",
          "descriptionFrom": "none"
        },
        {
          "name": "suggestions",
          "type": "SearchDialogItem[]",
          "default": "() => []",
          "required": false,
          "description": "Items shown while the query is empty: recents, frequent searches. The application measures and decides; the dialog displays. They may carry their own `group` (\"Recent\"). Empty means an empty query shows all items.",
          "descriptionFrom": "source"
        },
        {
          "name": "loading",
          "type": "boolean",
          "default": "false",
          "required": false,
          "description": "Results are being fetched: shows an indicator, announces \"Searching…\" through the status region and holds back the empty state meanwhile. Feed async results through `items` when they arrive.",
          "descriptionFrom": "source"
        },
        {
          "name": "open",
          "type": "boolean",
          "default": "false",
          "required": false,
          "description": "Initial / controlled open state; bindable with `v-model:open`.",
          "descriptionFrom": "source"
        },
        {
          "name": "title",
          "type": "string",
          "default": "undefined",
          "required": false,
          "description": "Accessible title for the dialog. Defaults to the catalog's \"Search\".",
          "descriptionFrom": "source"
        },
        {
          "name": "hideTitle",
          "type": "boolean",
          "default": "true",
          "required": false,
          "description": "Visually hide the title (the default: the search field reads as the header). It still names the dialog for screen readers.",
          "descriptionFrom": "source"
        },
        {
          "name": "closeButton",
          "type": "boolean",
          "default": "false",
          "required": false,
          "description": "Show a close button in the header; it closes like Escape.",
          "descriptionFrom": "source"
        },
        {
          "name": "closeLabel",
          "type": "string",
          "default": "undefined",
          "required": false,
          "description": "Accessible label for the close button. Defaults to the catalog's \"Close\".",
          "descriptionFrom": "source"
        },
        {
          "name": "label",
          "type": "string",
          "default": "undefined",
          "required": false,
          "description": "Accessible label for the search input. Defaults to the catalog's \"Search\".",
          "descriptionFrom": "source"
        },
        {
          "name": "placeholder",
          "type": "string",
          "default": "undefined",
          "required": false,
          "description": "Input placeholder. Defaults to the catalog's \"Type to search…\".",
          "descriptionFrom": "source"
        },
        {
          "name": "emptyText",
          "type": "string",
          "default": "undefined",
          "required": false,
          "description": "Text shown when nothing matches. Defaults to the catalog's \"No results found.\".",
          "descriptionFrom": "source"
        },
        {
          "name": "onSelect",
          "type": "(value: string) => void",
          "default": "undefined",
          "required": false,
          "description": "",
          "descriptionFrom": "none"
        },
        {
          "name": "onOpenChange",
          "type": "(open: boolean) => void",
          "default": "undefined",
          "required": false,
          "description": "",
          "descriptionFrom": "none"
        }
      ],
      "emits": [
        {
          "name": "update:open",
          "payload": "open: boolean"
        }
      ],
      "slots": [
        "trigger"
      ]
    },
    "elements": {
      "import": {
        "kind": "element",
        "name": "ds-search-dialog",
        "specifier": "@design-system/elements/define"
      },
      "attributes": [
        {
          "name": "heading",
          "reactive": true,
          "required": false,
          "description": "\"Search\" by default",
          "descriptionFrom": "source"
        },
        {
          "name": "hide-title",
          "reactive": true,
          "required": false,
          "description": "`\"false\"` shows the title",
          "descriptionFrom": "source"
        },
        {
          "name": "label",
          "reactive": true,
          "required": false,
          "description": "the input's accessible name, \"Search\" by default",
          "descriptionFrom": "source"
        },
        {
          "name": "placeholder",
          "reactive": true,
          "required": false,
          "description": "",
          "descriptionFrom": "none"
        },
        {
          "name": "empty-text",
          "reactive": true,
          "required": false,
          "description": "",
          "descriptionFrom": "none"
        },
        {
          "name": "loading",
          "reactive": true,
          "required": false,
          "description": "results are being fetched",
          "descriptionFrom": "source"
        },
        {
          "name": "trigger",
          "reactive": true,
          "required": false,
          "description": "opener text",
          "descriptionFrom": "source"
        },
        {
          "name": "trigger-variant",
          "reactive": true,
          "required": false,
          "description": "",
          "descriptionFrom": "none"
        },
        {
          "name": "open",
          "reactive": true,
          "required": false,
          "description": "",
          "descriptionFrom": "none"
        },
        {
          "name": "close-button",
          "reactive": true,
          "required": false,
          "description": "",
          "descriptionFrom": "none"
        },
        {
          "name": "close-label",
          "reactive": true,
          "required": false,
          "description": "",
          "descriptionFrom": "none"
        }
      ],
      "notes": [
        "Properties: `open` (boolean), `items` and `suggestions` (arrays of `{ value, label?, disabled?, group?, shortcut? }`).",
        "Emits: bubbling `open-change` CustomEvent with `detail.open`, and `select` with `detail.value` when a result is chosen."
      ]
    }
  }
}
