{
  "component": "button-group",
  "selected": false,
  "frameworks": {
    "svelte": {
      "import": {
        "kind": "default",
        "name": "ButtonGroup",
        "specifier": "@design-system/svelte/ButtonGroup.svelte"
      },
      "props": [
        {
          "name": "label",
          "type": "string",
          "default": null,
          "required": true,
          "description": "Accessible name for the group."
        },
        {
          "name": "orientation",
          "type": "Orientation",
          "default": "\"horizontal\"",
          "required": false,
          "description": "Layout direction."
        },
        {
          "name": "attached",
          "type": "boolean",
          "default": "true",
          "required": false,
          "description": "Visually merge the buttons into one bar."
        },
        {
          "name": "align",
          "type": "\"start\" | \"center\" | \"end\" | \"stretch\"",
          "default": "\"center\"",
          "required": false,
          "description": "Cross-axis alignment of the items. Defaults to `center` so a taller sibling (e.g. a Select with a label) never stretches the buttons; use `end` to line buttons up with a labelled control's input row, or `stretch` for equal heights."
        }
      ]
    },
    "vue": {
      "import": {
        "kind": "named",
        "name": "ButtonGroup",
        "specifier": "@design-system/vue"
      },
      "props": [
        {
          "name": "label",
          "type": "string",
          "default": null,
          "required": true,
          "description": "Accessible name for the group (required)."
        },
        {
          "name": "orientation",
          "type": "ButtonGroupOrientation",
          "default": "\"horizontal\"",
          "required": false,
          "description": ""
        },
        {
          "name": "attached",
          "type": "boolean",
          "default": "true",
          "required": false,
          "description": "Visually merge the buttons into one bar. Defaults to `true`."
        },
        {
          "name": "align",
          "type": "ButtonGroupAlign",
          "default": "\"center\"",
          "required": false,
          "description": "Cross-axis alignment of the items. Defaults to `center` so a taller sibling (e.g. a Select with a label) keeps the buttons at their own height; use `end` to line buttons up with a labelled control's input row, or `stretch` for equal heights."
        }
      ],
      "emits": [],
      "slots": [
        "default"
      ]
    }
  }
}
