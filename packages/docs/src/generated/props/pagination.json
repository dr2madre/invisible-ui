{
  "component": "pagination",
  "selected": false,
  "frameworks": {
    "svelte": {
      "import": {
        "kind": "default",
        "name": "Pagination",
        "specifier": "@design-system/svelte/Pagination.svelte"
      },
      "props": [
        {
          "name": "page",
          "type": "number",
          "default": "1",
          "required": false,
          "description": "Current page. Controllable mirror: clicking a page updates it locally and reports through `onPageChange`; a later prop value overwrites the local choice (clamped to `pageCount`) without a callback. The other props keep their initial-value behaviour.",
          "descriptionFrom": "source"
        },
        {
          "name": "pageCount",
          "type": "number",
          "default": null,
          "required": true,
          "description": "",
          "descriptionFrom": "none"
        },
        {
          "name": "siblingCount",
          "type": "number",
          "default": "1",
          "required": false,
          "description": "",
          "descriptionFrom": "none"
        },
        {
          "name": "boundaryCount",
          "type": "number",
          "default": "1",
          "required": false,
          "description": "",
          "descriptionFrom": "none"
        },
        {
          "name": "disabled",
          "type": "boolean",
          "default": "false",
          "required": false,
          "description": "",
          "descriptionFrom": "none"
        },
        {
          "name": "label",
          "type": "string | undefined",
          "default": "undefined",
          "required": false,
          "description": "Accessible name for the nav.",
          "descriptionFrom": "curated"
        },
        {
          "name": "onPageChange",
          "type": "((page: number) => void) | undefined",
          "default": "undefined",
          "required": false,
          "description": "Called when the page changes.",
          "descriptionFrom": "curated"
        }
      ]
    },
    "vue": {
      "import": {
        "kind": "named",
        "name": "Pagination",
        "specifier": "@design-system/vue"
      },
      "props": [
        {
          "name": "modelValue",
          "type": "number",
          "default": "undefined",
          "required": false,
          "description": "`v-model` value; takes precedence over `page` when bound.",
          "descriptionFrom": "source"
        },
        {
          "name": "page",
          "type": "number",
          "default": "1",
          "required": false,
          "description": "Current page (1-based).",
          "descriptionFrom": "source"
        },
        {
          "name": "pageCount",
          "type": "number",
          "default": null,
          "required": true,
          "description": "Total number of pages.",
          "descriptionFrom": "source"
        },
        {
          "name": "siblingCount",
          "type": "number",
          "default": "1",
          "required": false,
          "description": "Pages shown on each side of the current page.",
          "descriptionFrom": "source"
        },
        {
          "name": "boundaryCount",
          "type": "number",
          "default": "1",
          "required": false,
          "description": "Pages always shown at the start and end.",
          "descriptionFrom": "source"
        },
        {
          "name": "disabled",
          "type": "boolean",
          "default": "false",
          "required": false,
          "description": "",
          "descriptionFrom": "none"
        },
        {
          "name": "label",
          "type": "string",
          "default": "undefined",
          "required": false,
          "description": "Accessible name for the navigation landmark. Defaults to the catalog's \"Pagination\".",
          "descriptionFrom": "source"
        },
        {
          "name": "onPageChange",
          "type": "(page: number) => void",
          "default": "undefined",
          "required": false,
          "description": "Called whenever the page changes.",
          "descriptionFrom": "source"
        }
      ],
      "emits": [
        {
          "name": "update:modelValue",
          "payload": "page: number"
        }
      ],
      "slots": []
    },
    "elements": {
      "import": {
        "kind": "element",
        "name": "ds-pagination",
        "specifier": "@design-system/elements/define"
      },
      "attributes": [
        {
          "name": "page",
          "reactive": true,
          "required": false,
          "description": "",
          "descriptionFrom": "none"
        },
        {
          "name": "page-count",
          "reactive": true,
          "required": true,
          "description": "",
          "descriptionFrom": "none"
        },
        {
          "name": "sibling-count",
          "reactive": true,
          "required": false,
          "description": "",
          "descriptionFrom": "none"
        },
        {
          "name": "boundary-count",
          "reactive": true,
          "required": false,
          "description": "",
          "descriptionFrom": "none"
        },
        {
          "name": "disabled",
          "reactive": true,
          "required": false,
          "description": "",
          "descriptionFrom": "none"
        },
        {
          "name": "label",
          "reactive": true,
          "required": false,
          "description": "",
          "descriptionFrom": "none"
        },
        {
          "name": "previous-label",
          "reactive": true,
          "required": false,
          "description": "",
          "descriptionFrom": "none"
        },
        {
          "name": "next-label",
          "reactive": true,
          "required": false,
          "description": "",
          "descriptionFrom": "none"
        },
        {
          "name": "page-label",
          "reactive": true,
          "required": false,
          "description": "",
          "descriptionFrom": "none"
        }
      ],
      "notes": [
        "Emits: `change` (`detail.page`) after a user action changes the page."
      ]
    }
  }
}
