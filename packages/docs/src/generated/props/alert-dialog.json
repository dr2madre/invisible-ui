{
  "component": "alert-dialog",
  "selected": false,
  "frameworks": {
    "svelte": {
      "import": {
        "kind": "default",
        "name": "AlertDialog",
        "specifier": "@design-system/svelte/AlertDialog.svelte"
      },
      "props": [
        {
          "name": "open",
          "type": "boolean",
          "default": "false",
          "required": false,
          "description": "Initial open state.",
          "descriptionFrom": "source"
        },
        {
          "name": "title",
          "type": "string",
          "default": null,
          "required": true,
          "description": "Accessible title naming the alert.",
          "descriptionFrom": "curated"
        },
        {
          "name": "description",
          "type": "string",
          "default": null,
          "required": true,
          "description": "Description of the consequence.",
          "descriptionFrom": "curated"
        },
        {
          "name": "dismissLabel",
          "type": "string | undefined",
          "default": "undefined",
          "required": false,
          "description": "Label of the single acknowledging button. Defaults to the i18n catalog's \"OK\"; prefer naming the outcome in context (\"Done\", \"Close\", \"I understood\").",
          "descriptionFrom": "source"
        },
        {
          "name": "triggerVariant",
          "type": "ButtonVariant",
          "default": "\"default\"",
          "required": false,
          "description": "Visual variant for the trigger Button.",
          "descriptionFrom": "source"
        },
        {
          "name": "onDismiss",
          "type": "(() => void) | undefined",
          "default": "undefined",
          "required": false,
          "description": "Called when the alert is acknowledged (button, Escape or backdrop).",
          "descriptionFrom": "source"
        },
        {
          "name": "closeOnOutsideClick",
          "type": "boolean",
          "default": "true",
          "required": false,
          "description": "Whether pressing the backdrop (outside the panel) cancels and closes. Defaults to `true`; set `false` to force an explicit Cancel/confirm choice (e.g. for irreversible actions).",
          "descriptionFrom": "curated"
        },
        {
          "name": "closeButton",
          "type": "boolean",
          "default": "false",
          "required": false,
          "description": "Show a close button at the trailing end of the header; it closes like Escape.",
          "descriptionFrom": "source"
        },
        {
          "name": "closeLabel",
          "type": "string | undefined",
          "default": "undefined",
          "required": false,
          "description": "Accessible label for the close button. Defaults to the i18n catalog's \"Close\".",
          "descriptionFrom": "source"
        },
        {
          "name": "onOpenChange",
          "type": "((open: boolean) => void) | undefined",
          "default": "undefined",
          "required": false,
          "description": "Called when the alert opens/closes.",
          "descriptionFrom": "curated"
        }
      ]
    },
    "vue": {
      "import": {
        "kind": "named",
        "name": "AlertDialog",
        "specifier": "@design-system/vue"
      },
      "props": [
        {
          "name": "triggerVariant",
          "type": "ButtonVariant",
          "default": "\"default\"",
          "required": false,
          "description": "Visual variant for the trigger Button.",
          "descriptionFrom": "source"
        },
        {
          "name": "trigger",
          "type": "string",
          "default": "undefined",
          "required": false,
          "description": "The trigger button's label. The `trigger` slot replaces it with markup.",
          "descriptionFrom": "source"
        },
        {
          "name": "open",
          "type": "boolean",
          "default": "false",
          "required": false,
          "description": "Initial / controlled open state; bindable with `v-model:open`.",
          "descriptionFrom": "source"
        },
        {
          "name": "title",
          "type": "string",
          "default": null,
          "required": true,
          "description": "Accessible title naming the alert (required).",
          "descriptionFrom": "source"
        },
        {
          "name": "description",
          "type": "string",
          "default": null,
          "required": true,
          "description": "The message to acknowledge (required).",
          "descriptionFrom": "source"
        },
        {
          "name": "dismissLabel",
          "type": "string",
          "default": "undefined",
          "required": false,
          "description": "Label of the single acknowledging button. Defaults to the catalog's \"OK\"; prefer naming the outcome in context (\"Done\", \"Close\", \"I understood\").",
          "descriptionFrom": "source"
        },
        {
          "name": "onDismiss",
          "type": "() => void",
          "default": "undefined",
          "required": false,
          "description": "Called when the alert is acknowledged (button, Escape or backdrop).",
          "descriptionFrom": "source"
        },
        {
          "name": "closeOnOutsideClick",
          "type": "boolean",
          "default": "true",
          "required": false,
          "description": "Whether pressing the backdrop acknowledges and closes. Defaults to `true`; set `false` to require an explicit button press (e.g. \"I understood\").",
          "descriptionFrom": "source"
        },
        {
          "name": "onOpenChange",
          "type": "(open: boolean) => void",
          "default": "undefined",
          "required": false,
          "description": "",
          "descriptionFrom": "none"
        }
      ],
      "emits": [
        {
          "name": "update:open",
          "payload": "open: boolean"
        }
      ],
      "slots": [
        "trigger"
      ]
    }
  }
}
