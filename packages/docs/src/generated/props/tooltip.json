{
  "component": "tooltip",
  "selected": false,
  "frameworks": {
    "svelte": {
      "import": {
        "kind": "default",
        "name": "Tooltip",
        "specifier": "@design-system/svelte/Tooltip.svelte"
      },
      "props": [
        {
          "name": "text",
          "type": "string",
          "default": null,
          "required": true,
          "description": "The tooltip label.",
          "descriptionFrom": "curated"
        },
        {
          "name": "placement",
          "type": "TooltipContext[\"placement\"]",
          "default": "\"top\"",
          "required": false,
          "description": "Preferred placement; flips when there's no room.",
          "descriptionFrom": "curated"
        },
        {
          "name": "openDelay",
          "type": "number",
          "default": "300",
          "required": false,
          "description": "Delay before showing on hover, in ms (focus shows immediately).",
          "descriptionFrom": "curated"
        },
        {
          "name": "closeDelay",
          "type": "number",
          "default": "100",
          "required": false,
          "description": "Delay before hiding on leave, in ms.",
          "descriptionFrom": "curated"
        }
      ]
    },
    "vue": {
      "import": {
        "kind": "named",
        "name": "Tooltip",
        "specifier": "@design-system/vue"
      },
      "props": [
        {
          "name": "text",
          "type": "string",
          "default": null,
          "required": true,
          "description": "Tooltip label text.",
          "descriptionFrom": "source"
        },
        {
          "name": "placement",
          "type": "Placement",
          "default": "\"top\"",
          "required": false,
          "description": "",
          "descriptionFrom": "none"
        },
        {
          "name": "openDelay",
          "type": "number",
          "default": "300",
          "required": false,
          "description": "",
          "descriptionFrom": "none"
        },
        {
          "name": "closeDelay",
          "type": "number",
          "default": "100",
          "required": false,
          "description": "",
          "descriptionFrom": "none"
        }
      ],
      "emits": [],
      "slots": [
        "default"
      ]
    },
    "elements": {
      "import": {
        "kind": "element",
        "name": "ds-tooltip",
        "specifier": "@design-system/elements/define"
      },
      "attributes": [
        {
          "name": "text",
          "reactive": true,
          "required": true,
          "description": "",
          "descriptionFrom": "none"
        },
        {
          "name": "placement",
          "reactive": true,
          "required": false,
          "description": "Floating UI placement, `top` by default",
          "descriptionFrom": "source"
        },
        {
          "name": "open-delay",
          "reactive": false,
          "required": false,
          "description": "ms, 300",
          "descriptionFrom": "source"
        },
        {
          "name": "close-delay",
          "reactive": false,
          "required": false,
          "description": "ms, 100",
          "descriptionFrom": "source"
        }
      ],
      "notes": []
    }
  }
}
