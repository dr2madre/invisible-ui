{
  "component": "tooltip",
  "selected": false,
  "frameworks": {
    "svelte": {
      "import": {
        "kind": "default",
        "name": "Tooltip",
        "specifier": "@design-system/svelte/Tooltip.svelte"
      },
      "props": [
        {
          "name": "text",
          "type": "string",
          "default": null,
          "required": true,
          "description": "The tooltip label."
        },
        {
          "name": "placement",
          "type": "TooltipContext[\"placement\"]",
          "default": "\"top\"",
          "required": false,
          "description": "Preferred placement; flips when there's no room."
        },
        {
          "name": "openDelay",
          "type": "number",
          "default": "300",
          "required": false,
          "description": "Delay before showing on hover, in ms (focus shows immediately)."
        },
        {
          "name": "closeDelay",
          "type": "number",
          "default": "100",
          "required": false,
          "description": "Delay before hiding on leave, in ms."
        }
      ]
    },
    "vue": {
      "import": {
        "kind": "named",
        "name": "Tooltip",
        "specifier": "@design-system/vue"
      },
      "props": [
        {
          "name": "text",
          "type": "string",
          "default": null,
          "required": true,
          "description": "Tooltip label text."
        },
        {
          "name": "placement",
          "type": "Placement",
          "default": "\"top\"",
          "required": false,
          "description": ""
        },
        {
          "name": "openDelay",
          "type": "number",
          "default": "300",
          "required": false,
          "description": ""
        },
        {
          "name": "closeDelay",
          "type": "number",
          "default": "100",
          "required": false,
          "description": ""
        }
      ],
      "emits": [],
      "slots": [
        "default"
      ]
    }
  }
}
