{
  "component": "range-slider",
  "selected": false,
  "frameworks": {
    "svelte": {
      "import": {
        "kind": "default",
        "name": "RangeSlider",
        "specifier": "@design-system/svelte/RangeSlider.svelte"
      },
      "props": [
        {
          "name": "value",
          "type": "readonly [number, number]",
          "default": "[0, 100]",
