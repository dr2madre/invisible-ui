          "descriptionFrom": "none"
        },
        {
          "name": "label",
          "type": "string",
          "default": null,
          "required": true,
          "description": "Accessible name for the group.",
          "descriptionFrom": "source"
        },
        {
          "name": "thumbLabels",
          "type": "readonly [string, string]",
          "default": null,
          "required": true,
          "description": "Accessible name for each thumb: `[lowerLabel, upperLabel]`.",
          "descriptionFrom": "source"
        },
        {
          "name": "name",
          "type": "string | undefined",
          "default": "undefined",
          "required": false,
          "description": "Form field name — both thumbs submit under it, in order: `FormData.getAll(name)` reads `[String(lower), String(upper)]`.",
          "descriptionFrom": "source"
        },
        {
          "name": "showValue",
          "type": "boolean",
          "default": "false",
          "required": false,
          "description": "Show the current values to the side of the track.",
          "descriptionFrom": "source"
        },
        {
          "name": "showRange",
          "type": "boolean",
          "default": "false",
          "required": false,
          "description": "Show the min and max reference values under the ends of the track.",
          "descriptionFrom": "source"
        },
        {
          "name": "ticks",
          "type": "boolean",
          "default": "false",
          "required": false,
          "description": "Show tick marks at each step (only when the count is reasonable).",
          "descriptionFrom": "source"
        },
        {
          "name": "format",
          "type": "(value: number) => string",
          "default": "(v) => String(v)",
          "required": false,
          "description": "Format a displayed value (e.g. add a unit).",
          "descriptionFrom": "source"
        },
        {
          "name": "onValueChange",
          "type": "((value: readonly [number, number]) => void) | undefined",
          "default": "undefined",
          "required": false,
          "description": "Called with the complete pair whenever it changes.",
          "descriptionFrom": "source"
        }
      ]
    },
