        },
        {
          "name": "max",
          "type": "number",
          "default": "100",
          "required": false,
          "description": "",
          "descriptionFrom": "none"
        },
        {
          "name": "step",
          "type": "number",
          "default": "1",
          "required": false,
          "description": "",
          "descriptionFrom": "none"
        },
        {
          "name": "minDistance",
          "type": "number",
          "default": "0",
          "required": false,
          "description": "The gap the two thumbs may not close. They may touch; they never cross.",
          "descriptionFrom": "source"
        },
        {
          "name": "orientation",
          "type": "\"horizontal\" | \"vertical\"",
          "default": "\"horizontal\"",
