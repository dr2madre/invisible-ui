      },
      "props": [
        {
          "name": "label",
          "type": "string",
          "default": null,
          "required": true,
          "description": "Accessible, visible label (required).",
          "descriptionFrom": "source"
        },
        {
          "name": "items",
          "type": "MultiSelectItem[]",
          "default": null,
          "required": true,
          "description": "Ordered list of all options.",
          "descriptionFrom": "source"
        },
        {
          "name": "values",
          "type": "string[]",
          "default": "[]",
          "required": false,
          "description": "The selected values (controlled). Replace the array; do not mutate it.",
          "descriptionFrom": "source"
        },
        {
          "name": "onValuesChange",
          "type": "((values: string[]) => void) | undefined",
          "default": "undefined",
          "required": false,
          "description": "Called with the next values after a user action.",
          "descriptionFrom": "source"
        },
        {
          "name": "onInputValueChange",
          "type": "((text: string) => void) | undefined",
          "default": "undefined",
          "required": false,
