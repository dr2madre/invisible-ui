        },
        {
          "name": "disabled",
          "type": "boolean",
          "default": "false",
          "required": false,
          "description": "",
          "descriptionFrom": "none"
        },
        {
          "name": "readOnly",
          "type": "boolean",
          "default": "false",
          "required": false,
          "description": "Review-only: focus works, opening/adding/removing do not.",
          "descriptionFrom": "source"
        },
        {
          "name": "max",
          "type": "number | undefined",
          "default": "undefined",
          "required": false,
          "description": "Cap on additions; never removes existing values.",
          "descriptionFrom": "source"
        },
        {
          "name": "removeOnBackspace",
          "type": "boolean",
          "default": "false",
          "required": false,
          "description": "Opt in to Backspace removal from an empty input.",
          "descriptionFrom": "source"
        },
        {
          "name": "name",
          "type": "string | undefined",
          "default": "undefined",
          "required": false,
          "description": "Form field name; one hidden input per value is submitted under it.",
