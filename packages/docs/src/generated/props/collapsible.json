{
  "component": "collapsible",
  "selected": false,
  "frameworks": {
    "svelte": {
      "import": {
        "kind": "default",
        "name": "Collapsible",
        "specifier": "@design-system/svelte/Collapsible.svelte"
      },
      "props": [
        {
          "name": "open",
          "type": "boolean",
          "default": "false",
          "required": false,
          "description": "Whether the region is expanded.",
          "descriptionFrom": "curated"
        },
        {
          "name": "disabled",
          "type": "boolean",
          "default": "false",
          "required": false,
          "description": "Disable the trigger.",
          "descriptionFrom": "curated"
        },
        {
          "name": "label",
          "type": "string | undefined",
          "default": "undefined",
          "required": false,
          "description": "Trigger text (or use the `trigger` snippet).",
          "descriptionFrom": "curated"
        },
        {
          "name": "onOpenChange",
          "type": "((open: boolean) => void) | undefined",
          "default": "undefined",
          "required": false,
          "description": "Called when toggled.",
          "descriptionFrom": "curated"
        },
        {
          "name": "trigger",
          "type": "Snippet | undefined",
          "default": "undefined",
          "required": false,
          "description": "The trigger's content. Defaults to `label`, then the i18n catalog's label.",
          "descriptionFrom": "source"
        }
      ]
    },
    "vue": {
      "import": {
        "kind": "named",
        "name": "Collapsible",
        "specifier": "@design-system/vue"
      },
      "props": [
        {
          "name": "open",
          "type": "boolean",
          "default": "false",
          "required": false,
          "description": "Open state; bindable with `v-model:open`.",
          "descriptionFrom": "source"
        },
        {
          "name": "disabled",
          "type": "boolean",
          "default": "false",
          "required": false,
          "description": "",
          "descriptionFrom": "none"
        },
        {
          "name": "label",
          "type": "string",
          "default": "undefined",
          "required": false,
          "description": "Trigger text, used when the `trigger` slot is not provided.",
          "descriptionFrom": "source"
        },
        {
          "name": "onOpenChange",
          "type": "(open: boolean) => void",
          "default": "undefined",
          "required": false,
          "description": "Called whenever the open state changes.",
          "descriptionFrom": "source"
        }
      ],
      "emits": [
        {
          "name": "update:open",
          "payload": "open: boolean"
        }
      ],
      "slots": [
        "default",
        "trigger"
      ]
    },
    "react": {
      "import": {
        "kind": "named",
        "name": "Collapsible",
        "specifier": "@design-system/react"
      },
      "extends": [],
      "props": [
        {
          "name": "open",
          "type": "boolean",
          "default": "false",
          "required": false,
          "description": "Initial (uncontrolled) or current (controlled) open state.",
          "descriptionFrom": "source"
        },
        {
          "name": "disabled",
          "type": "boolean",
          "default": "false",
          "required": false,
          "description": "Whether the collapsible is disabled.",
          "descriptionFrom": "source"
        },
        {
          "name": "label",
          "type": "string",
          "default": null,
          "required": false,
          "description": "Trigger text, used when `trigger` is not given.",
          "descriptionFrom": "source"
        },
        {
          "name": "trigger",
          "type": "ReactNode",
          "default": null,
          "required": false,
          "description": "The trigger's content. Defaults to `label`, then the catalog's \"Toggle\".",
          "descriptionFrom": "source"
        },
        {
          "name": "onOpenChange",
          "type": "(open: boolean) => void",
          "default": null,
          "required": false,
          "description": "Called whenever the open state changes.",
          "descriptionFrom": "source"
        },
        {
          "name": "children",
          "type": "ReactNode",
          "default": null,
          "required": false,
          "description": "The collapsible content.",
          "descriptionFrom": "source"
        }
      ]
    },
    "elements": {
      "import": {
        "kind": "element",
        "name": "ds-collapsible",
        "specifier": "@design-system/elements/define"
      },
      "attributes": [
        {
          "name": "open",
          "reactive": true,
          "required": false,
          "description": "",
          "descriptionFrom": "none"
        },
        {
          "name": "disabled",
          "reactive": true,
          "required": false,
          "description": "",
          "descriptionFrom": "none"
        },
        {
          "name": "label",
          "reactive": true,
          "required": false,
          "description": "the trigger text; \"Toggle\" by default",
          "descriptionFrom": "source"
        }
      ],
      "notes": [
        "Properties: `open`.",
        "Emits: bubbling `open-change` CustomEvent with `detail.open`."
      ]
    }
  }
}
