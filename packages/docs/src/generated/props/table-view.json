{
  "component": "table-view",
  "selected": false,
  "frameworks": {
    "svelte": {
      "import": {
        "kind": "default",
        "name": "TableView",
        "specifier": "@design-system/svelte/TableView.svelte"
      },
      "props": [
        {
          "name": "columns",
          "type": "TableColumnDef[]",
          "default": null,
          "required": true,
          "description": ""
        },
        {
          "name": "rows",
          "type": "TableRow[]",
          "default": null,
          "required": true,
          "description": ""
        },
        {
          "name": "caption",
          "type": "string | undefined",
          "default": "undefined",
          "required": false,
          "description": ""
        },
        {
          "name": "hideCaption",
          "type": "boolean",
          "default": "false",
          "required": false,
          "description": ""
        },
        {
          "name": "title",
          "type": "string | undefined",
          "default": "undefined",
          "required": false,
          "description": "Optional title, rendered on the same row as the view controls."
        },
        {
          "name": "titleLevel",
          "type": "2 | 3 | 4 | 5 | 6",
          "default": "2",
          "required": false,
          "description": ""
        },
        {
          "name": "pageSize",
          "type": "number | undefined",
          "default": "undefined",
          "required": false,
          "description": ""
        },
        {
          "name": "page",
          "type": "number",
          "default": "1",
          "required": false,
          "description": ""
        },
        {
          "name": "paginationLabel",
          "type": "string | undefined",
          "default": "undefined",
          "required": false,
          "description": "Accessible name for the pagination nav. Defaults to the i18n catalog's \"Table pages\"."
        },
        {
          "name": "onPageChange",
          "type": "((page: number) => void) | undefined",
          "default": "undefined",
          "required": false,
          "description": ""
        },
        {
          "name": "infinite",
          "type": "boolean",
          "default": "false",
          "required": false,
          "description": ""
        },
        {
          "name": "hasMore",
          "type": "boolean",
          "default": "false",
          "required": false,
          "description": ""
        },
        {
          "name": "loading",
          "type": "boolean",
          "default": "false",
          "required": false,
          "description": ""
        },
        {
          "name": "onLoadMore",
          "type": "(() => void) | undefined",
          "default": "undefined",
          "required": false,
          "description": ""
        },
        {
          "name": "loadMoreLabel",
          "type": "string | undefined",
          "default": "undefined",
          "required": false,
          "description": "Load-more button text. Defaults to the i18n catalog's \"Load more\"."
        },
        {
          "name": "loadingLabel",
          "type": "string | undefined",
          "default": "undefined",
          "required": false,
          "description": "Loading status text. Defaults to the i18n catalog's \"Loading…\"."
        },
        {
          "name": "sort",
          "type": "SortState | null",
          "default": "null",
          "required": false,
          "description": ""
        },
        {
          "name": "onSortChange",
          "type": "((sort: SortState | null) => void) | undefined",
          "default": "undefined",
          "required": false,
          "description": ""
        },
        {
          "name": "hiddenColumns",
          "type": "string[]",
          "default": "[]",
          "required": false,
          "description": ""
        },
        {
          "name": "onHiddenColumnsChange",
          "type": "((hidden: string[]) => void) | undefined",
          "default": "undefined",
          "required": false,
          "description": ""
        },
        {
          "name": "view",
          "type": "\"table\" | \"card\"",
          "default": "\"table\"",
          "required": false,
          "description": ""
        },
        {
          "name": "allowViewToggle",
          "type": "boolean",
          "default": "false",
          "required": false,
          "description": ""
        },
        {
          "name": "configurable",
          "type": "boolean",
          "default": "false",
          "required": false,
          "description": ""
        },
        {
          "name": "configLabel",
          "type": "string | undefined",
          "default": "undefined",
          "required": false,
          "description": "Column-visibility dropdown label. Defaults to the i18n catalog's \"Columns\"."
        },
        {
          "name": "cardTitleKey",
          "type": "string | undefined",
          "default": "undefined",
          "required": false,
          "description": ""
        },
        {
          "name": "cardDescriptionKey",
          "type": "string | undefined",
          "default": "undefined",
          "required": false,
          "description": ""
        },
        {
          "name": "getValue",
          "type": "(row: TableRow, key: string) => unknown",
          "default": "(row, key) => row[key]",
          "required": false,
          "description": ""
        },
        {
          "name": "getRowId",
          "type": "(row: TableRow, index: number) => string | number",
          "default": "defaultGetRowId",
          "required": false,
          "description": ""
        },
        {
          "name": "selectionMode",
          "type": "SelectionMode",
          "default": "\"none\"",
          "required": false,
          "description": ""
        },
        {
          "name": "selectedRowIds",
          "type": "RowId[]",
          "default": "[]",
          "required": false,
          "description": "The selected row ids (controlled). Replace the array; do not mutate it."
        },
        {
          "name": "onSelectedRowIdsChange",
          "type": "((ids: RowId[]) => void) | undefined",
          "default": "undefined",
          "required": false,
          "description": ""
        },
        {
          "name": "isRowSelectable",
          "type": "(row: TableRow) => boolean",
          "default": "() => true",
          "required": false,
          "description": "Marks rows the user may select. Others render without a checkbox."
        },
        {
          "name": "getRowLabel",
          "type": "((row: TableRow) => string) | undefined",
          "default": "undefined",
          "required": false,
          "description": "Names a row for its selection checkbox (\"Select {name}\"). Optional in the type, but required at runtime whenever selection is active."
        },
        {
          "name": "filtersActive",
          "type": "boolean",
          "default": "false",
          "required": false,
          "description": "Whether the consumer's filters are active. Filtering itself stays outside."
        },
        {
          "name": "totalRowCount",
          "type": "number | undefined",
          "default": "undefined",
          "required": false,
          "description": "Total unfiltered row count when known; `0` means the dataset is empty."
        },
        {
          "name": "filterRevision",
          "type": "string | number | undefined",
          "default": "undefined",
          "required": false,
          "description": "Changing this (or `filtersActive`) resets the local page to one."
        },
        {
          "name": "onClearFilters",
          "type": "(() => void) | undefined",
          "default": "undefined",
          "required": false,
          "description": "Clears the consumer's filters; enables the built-in no-results action."
        },
        {
          "name": "noResultsLabel",
          "type": "string | undefined",
          "default": "undefined",
          "required": false,
          "description": "Copy for the no-results state. Defaults to the i18n catalog's message."
        }
      ]
    }
  }
}
