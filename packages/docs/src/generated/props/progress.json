{
  "component": "progress",
  "selected": false,
  "frameworks": {
    "svelte": {
      "import": {
        "kind": "default",
        "name": "Progress",
        "specifier": "@design-system/svelte/Progress.svelte"
      },
      "props": [
        {
          "name": "value",
          "type": "number",
          "default": "0",
          "required": false,
          "description": "Completion (`null` = indeterminate).",
          "descriptionFrom": "curated"
        },
        {
          "name": "min",
          "type": "number",
          "default": "0",
          "required": false,
          "description": "Range bounds.",
          "descriptionFrom": "curated"
        },
        {
          "name": "max",
          "type": "number",
          "default": "100",
          "required": false,
          "description": "Range bounds.",
          "descriptionFrom": "curated"
        },
        {
          "name": "shape",
          "type": "\"bar\" | \"circle\"",
          "default": "\"bar\"",
          "required": false,
          "description": "Shape: a linear `bar` (default) or a `circle` ring (upload/export).",
          "descriptionFrom": "source"
        },
        {
          "name": "showValue",
          "type": "boolean",
          "default": "false",
          "required": false,
          "description": "Show the percentage inside the circle (determinate `circle` only).",
          "descriptionFrom": "source"
        },
        {
          "name": "label",
          "type": "string",
          "default": null,
          "required": true,
          "description": "Accessible name.",
          "descriptionFrom": "curated"
        }
      ]
    },
    "vue": {
      "import": {
        "kind": "named",
        "name": "Progress",
        "specifier": "@design-system/vue"
      },
      "props": [
        {
          "name": "value",
          "type": "number",
          "default": "0",
          "required": false,
          "description": "Current value (determinate — see Loading for indeterminate waiting).",
          "descriptionFrom": "source"
        },
        {
          "name": "min",
          "type": "number",
          "default": "0",
          "required": false,
          "description": "Minimum value.",
          "descriptionFrom": "source"
        },
        {
          "name": "max",
          "type": "number",
          "default": "100",
          "required": false,
          "description": "Maximum value.",
          "descriptionFrom": "source"
        },
        {
          "name": "shape",
          "type": "\"bar\" | \"circle\"",
          "default": "\"bar\"",
          "required": false,
          "description": "Shape: a linear `bar` (default) or a `circle` ring (upload/export).",
          "descriptionFrom": "source"
        },
        {
          "name": "showValue",
          "type": "boolean",
          "default": "false",
          "required": false,
          "description": "Show the percentage inside the circle (determinate `circle` only).",
          "descriptionFrom": "source"
        },
        {
          "name": "label",
          "type": "string",
          "default": null,
          "required": true,
          "description": "Accessible name for the progress bar (required).",
          "descriptionFrom": "source"
        }
      ],
      "emits": [],
      "slots": []
    },
    "elements": {
      "import": {
        "kind": "element",
        "name": "ds-progress",
        "specifier": "@design-system/elements/define"
      },
      "attributes": [
        {
          "name": "label",
          "reactive": true,
          "required": true,
          "description": "the accessible name",
          "descriptionFrom": "source"
        },
        {
          "name": "value",
          "reactive": true,
          "required": false,
          "description": "the current value; 0 by default",
          "descriptionFrom": "source"
        },
        {
          "name": "min",
          "reactive": true,
          "required": false,
          "description": "the range start; 0 by default",
          "descriptionFrom": "source"
        },
        {
          "name": "max",
          "reactive": true,
          "required": false,
          "description": "the range end; 100 by default",
          "descriptionFrom": "source"
        },
        {
          "name": "shape",
          "reactive": true,
          "required": false,
          "description": "bar|circle",
          "descriptionFrom": "source"
        },
        {
          "name": "show-value",
          "reactive": true,
          "required": false,
          "description": "the percentage inside the circle",
          "descriptionFrom": "source"
        }
      ],
      "notes": [
        "Properties: `value`, `min`, `max`."
      ]
    }
  }
}
