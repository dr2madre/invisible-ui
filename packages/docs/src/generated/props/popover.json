{
  "component": "popover",
  "selected": false,
  "frameworks": {
    "svelte": {
      "import": {
        "kind": "default",
        "name": "Popover",
        "specifier": "@design-system/svelte/Popover.svelte"
      },
      "props": [
        {
          "name": "trigger",
          "type": "\"click\" | \"hover\"",
          "default": "\"click\"",
          "required": false,
          "description": "Opening contract: an intentional click, or a hover/focus preview."
        },
        {
          "name": "triggerVariant",
          "type": "\"default\" | \"primary\" | \"secondary\" | \"ghost\" | \"danger\"",
          "default": "\"default\"",
          "required": false,
          "description": "Visual variant for the trigger Button (`trigger=\"click\"` only)."
        },
        {
          "name": "open",
          "type": "boolean",
          "default": "false",
          "required": false,
          "description": "Initial open state."
        },
        {
          "name": "placement",
          "type": "PopoverContext[\"placement\"]",
          "default": "\"bottom\"",
          "required": false,
          "description": "Preferred placement (Floating UI); flips when there's no room."
        },
        {
          "name": "openDelay",
          "type": "number",
          "default": "300",
          "required": false,
          "description": "Delay before opening on hover, in ms (`trigger=\"hover\"` only)."
        },
        {
          "name": "closeDelay",
          "type": "number",
          "default": "200",
          "required": false,
          "description": "Delay before closing on leave, in ms (`trigger=\"hover\"` only)."
        },
        {
          "name": "onOpenChange",
          "type": "((open: boolean) => void) | undefined",
          "default": "undefined",
          "required": false,
          "description": "Called when the panel opens/closes."
        }
      ]
    },
    "vue": {
      "import": {
        "kind": "named",
        "name": "Popover",
        "specifier": "@design-system/vue"
      },
      "props": [
        {
          "name": "trigger",
          "type": "\"click\" | \"hover\"",
          "default": "\"click\"",
          "required": false,
          "description": "Opening contract: an intentional click, or a hover/focus preview."
        },
        {
          "name": "triggerVariant",
          "type": "ButtonVariant",
          "default": "\"default\"",
          "required": false,
          "description": "Visual variant for the trigger Button (`trigger=\"click\"` only)."
        },
        {
          "name": "open",
          "type": "boolean",
          "default": "false",
          "required": false,
          "description": "Initial / controlled open state; bindable with `v-model:open`."
        },
        {
          "name": "placement",
          "type": "Placement",
          "default": "\"bottom\"",
          "required": false,
          "description": "Preferred placement of the panel."
        },
        {
          "name": "openDelay",
          "type": "number",
          "default": "300",
          "required": false,
          "description": "Delay before opening on hover, in ms (`trigger=\"hover\"` only)."
        },
        {
          "name": "closeDelay",
          "type": "number",
          "default": "200",
          "required": false,
          "description": "Delay before closing on leave, in ms (`trigger=\"hover\"` only)."
        },
        {
          "name": "onOpenChange",
          "type": "(open: boolean) => void",
          "default": "undefined",
          "required": false,
          "description": ""
        }
      ],
      "emits": [
        {
          "name": "update:open",
          "payload": "open: boolean"
        }
      ],
      "slots": [
        "default",
        "trigger"
      ]
    }
  }
}
