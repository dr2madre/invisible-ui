      "props": [
        {
          "name": "trigger",
          "type": "\"click\" | \"hover\"",
          "default": "\"click\"",
          "required": false,
          "description": "Opening contract: an intentional click, or a hover/focus preview.",
          "descriptionFrom": "source"
        },
        {
          "name": "triggerVariant",
          "type": "\"default\" | \"primary\" | \"secondary\" | \"ghost\" | \"danger\"",
          "default": "\"default\"",
          "required": false,
          "description": "Visual variant for the trigger Button (`trigger=\"click\"` only).",
          "descriptionFrom": "source"
        },
        {
          "name": "open",
          "type": "boolean",
          "default": "false",
          "required": false,
          "description": "Initial open state.",
          "descriptionFrom": "source"
        },
        {
          "name": "placement",
          "type": "PopoverContext[\"placement\"]",
          "default": "\"bottom\"",
          "required": false,
          "description": "Preferred placement (Floating UI); flips when there's no room.",
          "descriptionFrom": "curated"
        },
        {
          "name": "openDelay",
          "type": "number",
          "default": "300",
          "required": false,
          "description": "Delay before opening on hover, in ms (`trigger=\"hover\"` only).",
          "descriptionFrom": "source"
        },
        {
          "name": "closeDelay",
          "type": "number",
          "default": "200",
          "required": false,
          "description": "Delay before closing on leave, in ms (`trigger=\"hover\"` only).",
          "descriptionFrom": "source"
        },
        {
          "name": "label",
          "type": "string | undefined",
          "default": "undefined",
          "required": false,
