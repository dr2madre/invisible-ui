          "descriptionFrom": "source"
        },
        {
          "name": "onOpenChange",
          "type": "((open: boolean) => void) | undefined",
          "default": "undefined",
          "required": false,
          "description": "Called when the panel opens/closes.",
          "descriptionFrom": "curated"
        }
      ]
    },
    "vue": {
      "import": {
        "kind": "named",
