{
  "component": "navigation-bar",
  "selected": false,
  "frameworks": {
    "svelte": {
      "import": {
        "kind": "default",
        "name": "NavigationBar",
        "specifier": "@design-system/svelte/NavigationBar.svelte"
      },
      "props": [
        {
          "name": "destinations",
          "type": "NavigationDestination[]",
          "default": null,
          "required": true,
          "description": "The destinations, in reading order.",
          "descriptionFrom": "source"
        },
        {
          "name": "value",
          "type": "string | null",
          "default": "null",
          "required": false,
          "description": "The current destination's value. The application owns it.",
          "descriptionFrom": "source"
        },
        {
          "name": "label",
          "type": "string | undefined",
          "default": "undefined",
          "required": false,
          "description": "Accessible name for the landmark. Defaults to the catalog's \"Main\".",
          "descriptionFrom": "source"
        },
        {
          "name": "onSelect",
          "type": "((value: string) => void) | undefined",
          "default": "undefined",
          "required": false,
          "description": "Called with a button destination's value on every activation.",
          "descriptionFrom": "source"
        },
        {
          "name": "unavailableIcon",
          "type": "Snippet | undefined",
          "default": "undefined",
          "required": false,
          "description": "Replaces the lock glyph that marks an unavailable destination.",
          "descriptionFrom": "source"
        }
      ]
    }
  }
}
