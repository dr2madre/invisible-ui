{
  "component": "link",
  "selected": false,
  "frameworks": {
    "svelte": {
      "import": {
        "kind": "default",
        "name": "Link",
        "specifier": "@design-system/svelte/Link.svelte"
      },
      "props": [
        {
          "name": "href",
          "type": "string | undefined",
          "default": "undefined",
          "required": false,
          "description": "Destination URL."
        },
        {
          "name": "external",
          "type": "boolean",
          "default": "false",
          "required": false,
          "description": "Open in a new tab (adds target/rel and a trailing arrow icon)."
        },
        {
          "name": "variant",
          "type": "\"primary\" | \"subtle\"",
          "default": "\"primary\"",
          "required": false,
          "description": "Tone down to the surrounding text colour (still underlined on hover)."
        },
        {
          "name": "onpress",
          "type": "((event: MouseEvent) => void) | undefined",
          "default": "undefined",
          "required": false,
          "description": "Optional press handler (useful when there is no `href`)."
        }
      ]
    },
    "vue": {
      "import": {
        "kind": "named",
        "name": "Link",
        "specifier": "@design-system/vue"
      },
      "props": [
        {
          "name": "href",
          "type": "string",
          "default": "undefined",
          "required": false,
          "description": "Destination URL."
        },
        {
          "name": "external",
          "type": "boolean",
          "default": "false",
          "required": false,
          "description": "Open in a new tab (adds target/rel and a trailing arrow icon)."
        },
        {
          "name": "variant",
          "type": "LinkVariant",
          "default": "\"primary\"",
          "required": false,
          "description": "Tone down to the surrounding text colour (still underlined on hover)."
        },
        {
          "name": "onPress",
          "type": "(event: MouseEvent) => void",
          "default": "undefined",
          "required": false,
          "description": "Optional press handler (useful when there is no `href`)."
        }
      ],
      "emits": [],
      "slots": [
        "default"
      ]
    }
  }
}
