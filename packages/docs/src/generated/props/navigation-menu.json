{
  "component": "navigation-menu",
  "selected": false,
  "frameworks": {
    "svelte": {
      "import": {
        "kind": "default",
        "name": "NavigationMenu",
        "specifier": "@design-system/svelte/NavigationMenu.svelte"
      },
      "props": [
        {
          "name": "label",
          "type": "string",
          "default": null,
          "required": true,
          "description": "Accessible name for the `<nav>` landmark.",
          "descriptionFrom": "curated"
        },
        {
          "name": "items",
          "type": "NavigationMenuItem[]",
          "default": null,
          "required": true,
          "description": "Links (`{ value, label, href }`) or panels (`{ value, label, links }`).",
          "descriptionFrom": "curated"
        },
        {
          "name": "onValueChange",
          "type": "((value: string | null) => void) | undefined",
          "default": "undefined",
          "required": false,
          "description": "Called when the open panel changes.",
          "descriptionFrom": "curated"
        }
      ]
    },
    "vue": {
      "import": {
        "kind": "named",
        "name": "NavigationMenu",
        "specifier": "@design-system/vue"
      },
      "props": [
        {
          "name": "label",
          "type": "string",
          "default": null,
          "required": true,
          "description": "Accessible name for the navigation landmark.",
          "descriptionFrom": "source"
        },
        {
          "name": "items",
          "type": "NavigationMenuItem[]",
          "default": null,
          "required": true,
          "description": "",
          "descriptionFrom": "none"
        },
        {
          "name": "onValueChange",
          "type": "(value: string | null) => void",
          "default": "undefined",
          "required": false,
          "description": "",
          "descriptionFrom": "none"
        }
      ],
      "emits": [],
      "slots": []
    },
    "elements": {
      "import": {
        "kind": "element",
        "name": "ds-navigation-menu",
        "specifier": "@design-system/elements/define"
      },
      "attributes": [
        {
          "name": "label",
          "reactive": true,
          "required": true,
          "description": ": the landmark name",
          "descriptionFrom": "source"
        },
        {
          "name": "value",
          "reactive": true,
          "required": false,
          "description": "the open item",
          "descriptionFrom": "source"
        },
        {
          "name": "open-delay",
          "reactive": false,
          "required": false,
          "description": "ms, 150",
          "descriptionFrom": "source"
        },
        {
          "name": "close-delay",
          "reactive": false,
          "required": false,
          "description": "ms, 150",
          "descriptionFrom": "source"
        }
      ],
      "notes": [
        "Properties: `items`, `value`.",
        "Emits: bubbling `value-change` with `detail.value` (`null` when closed)."
      ]
    }
  }
}
