          "required": false,
          "description": "Called when an item is activated.",
          "descriptionFrom": "curated"
        }
      ]
    },
    "vue": {
      "import": {
        "kind": "named",
        "name": "Menubar",
        "specifier": "@design-system/vue"
      },
      "props": [
        {
          "name": "label",
          "type": "string",
          "default": null,
          "required": true,
          "description": "Accessible name for the bar.",
          "descriptionFrom": "source"
        },
        {
          "name": "menus",
          "type": "MenubarMenu[]",
          "default": null,
          "required": true,
          "description": "The top-level menus.",
