{
  "component": "rating-group",
  "selected": false,
  "frameworks": {
    "svelte": {
      "import": {
        "kind": "default",
        "name": "RatingGroup",
        "specifier": "@design-system/svelte/RatingGroup.svelte"
      },
      "props": [
        {
          "name": "label",
          "type": "string",
          "default": null,
          "required": true,
          "description": "Accessible group name.",
          "descriptionFrom": "curated"
        },
        {
          "name": "max",
          "type": "number",
          "default": "5",
          "required": false,
          "description": "Number of stars.",
          "descriptionFrom": "source"
        },
        {
          "name": "value",
          "type": "number | null",
          "default": "null",
          "required": false,
          "description": "Current rating.",
          "descriptionFrom": "curated"
        },
        {
          "name": "disabled",
          "type": "boolean",
          "default": "false",
          "required": false,
          "description": "Disable the group.",
          "descriptionFrom": "curated"
        },
        {
          "name": "name",
          "type": "string | undefined",
          "default": "undefined",
          "required": false,
          "description": "Form field name — the rating is submitted under it.",
          "descriptionFrom": "source"
        },
        {
          "name": "onValueChange",
          "type": "((value: number) => void) | undefined",
          "default": "undefined",
          "required": false,
          "description": "Called when the rating changes.",
          "descriptionFrom": "curated"
        }
      ]
    },
    "vue": {
      "import": {
        "kind": "named",
        "name": "RatingGroup",
        "specifier": "@design-system/vue"
      },
      "props": [
        {
          "name": "label",
          "type": "string",
          "default": null,
          "required": true,
          "description": "Accessible name for the rating group (required).",
          "descriptionFrom": "source"
        },
        {
          "name": "max",
          "type": "number",
          "default": "5",
          "required": false,
          "description": "Number of stars.",
          "descriptionFrom": "source"
        },
        {
          "name": "modelValue",
          "type": "number | null",
          "default": "undefined",
          "required": false,
          "description": "`v-model` value; takes precedence over `value` when bound.",
          "descriptionFrom": "source"
        },
        {
          "name": "value",
          "type": "number | null",
          "default": "null",
          "required": false,
          "description": "Selected rating (1..max), or null.",
          "descriptionFrom": "source"
        },
        {
          "name": "disabled",
          "type": "boolean",
          "default": "false",
          "required": false,
          "description": "",
          "descriptionFrom": "none"
        },
        {
          "name": "name",
          "type": "string",
          "default": "undefined",
          "required": false,
          "description": "Form field name; the rating is submitted under it.",
          "descriptionFrom": "source"
        },
        {
          "name": "onValueChange",
          "type": "(value: number) => void",
          "default": "undefined",
          "required": false,
          "description": "Called whenever the rating changes.",
          "descriptionFrom": "source"
        }
      ],
      "emits": [
        {
          "name": "update:modelValue",
          "payload": "value: number | null"
        }
      ],
      "slots": []
    },
    "elements": {
      "import": {
        "kind": "element",
        "name": "ds-rating-group",
        "specifier": "@design-system/elements/define"
      },
      "attributes": [
        {
          "name": "label",
          "reactive": true,
          "required": true,
          "description": "the group's accessible name",
          "descriptionFrom": "source"
        },
        {
          "name": "max",
          "reactive": true,
          "required": false,
          "description": "the number of stars; 5 by default",
          "descriptionFrom": "source"
        },
        {
          "name": "value",
          "reactive": true,
          "required": false,
          "description": "the selected rating, 1 to `max`",
          "descriptionFrom": "source"
        },
        {
          "name": "name",
          "reactive": true,
          "required": false,
          "description": "generated when absent, so the stars still form one group",
          "descriptionFrom": "source"
        },
        {
          "name": "disabled",
          "reactive": true,
          "required": false,
          "description": "",
          "descriptionFrom": "none"
        }
      ],
      "notes": [
        "Properties: `value` (number or null).",
        "Emits: bubbling `change` CustomEvent with `detail.value`, the rating as a number."
      ]
    }
  }
}
