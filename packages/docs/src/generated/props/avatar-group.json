{
  "component": "avatar-group",
  "selected": false,
  "frameworks": {
    "svelte": {
      "import": {
        "kind": "default",
        "name": "AvatarGroup",
        "specifier": "@design-system/svelte/AvatarGroup.svelte"
      },
      "props": [
        {
          "name": "items",
          "type": "AvatarGroupItem[]",
          "default": null,
          "required": true,
          "description": "People (`{ name, src?, alt? }`); `name` is the initials fallback."
        },
        {
          "name": "max",
          "type": "number",
          "default": "4",
          "required": false,
          "description": "Visible avatars before the \"+N\" chip."
        },
        {
          "name": "size",
          "type": "\"sm\" | \"md\" | \"lg\"",
          "default": "\"md\"",
          "required": false,
          "description": "Avatar size."
        },
        {
          "name": "shape",
          "type": "\"circle\" | \"square\"",
          "default": "\"circle\"",
          "required": false,
          "description": "Avatar shape."
        },
        {
          "name": "label",
          "type": "string",
          "default": null,
          "required": true,
          "description": "Accessible name for the group."
        }
      ]
    },
    "vue": {
      "import": {
        "kind": "named",
        "name": "AvatarGroup",
        "specifier": "@design-system/vue"
      },
      "props": [
        {
          "name": "items",
          "type": "AvatarGroupItem[]",
          "default": null,
          "required": true,
          "description": "The people in the group."
        },
        {
          "name": "max",
          "type": "number",
          "default": "4",
          "required": false,
          "description": "Maximum avatars to show before collapsing the rest into a \"+N\" chip."
        },
        {
          "name": "size",
          "type": "\"sm\" | \"md\" | \"lg\"",
          "default": "\"md\"",
          "required": false,
          "description": ""
        },
        {
          "name": "shape",
          "type": "\"circle\" | \"square\"",
          "default": "\"circle\"",
          "required": false,
          "description": ""
        },
        {
          "name": "label",
          "type": "string",
          "default": null,
          "required": true,
          "description": "Accessible name for the group (announced by screen readers)."
        }
      ],
      "emits": [],
      "slots": []
    }
  }
}
