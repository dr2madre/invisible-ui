{
  "component": "tabs",
  "selected": false,
  "frameworks": {
    "svelte": {
      "import": {
        "kind": "default",
        "name": "Tabs",
        "specifier": "@design-system/svelte/Tabs.svelte"
      },
      "props": [
        {
          "name": "items",
          "type": "TabsItem[]",
          "default": null,
          "required": true,
          "description": "",
          "descriptionFrom": "none"
        },
        {
          "name": "value",
          "type": "string | null",
          "default": "null",
          "required": false,
          "description": "",
          "descriptionFrom": "none"
        },
        {
          "name": "activationMode",
          "type": "ActivationMode",
          "default": "\"automatic\"",
          "required": false,
          "description": "",
          "descriptionFrom": "none"
        },
        {
          "name": "label",
          "type": "string",
          "default": null,
          "required": true,
          "description": "Accessible name for the tab list.",
          "descriptionFrom": "curated"
        },
        {
          "name": "onValueChange",
          "type": "((value: string) => void) | undefined",
          "default": "undefined",
          "required": false,
          "description": "Called whenever the selected tab changes.",
          "descriptionFrom": "source"
        }
      ]
    },
    "vue": {
      "import": {
        "kind": "named",
        "name": "Tabs",
        "specifier": "@design-system/vue"
      },
      "props": [
        {
          "name": "items",
          "type": "TabsItem[]",
          "default": null,
          "required": true,
          "description": "Ordered list of tabs.",
          "descriptionFrom": "source"
        },
        {
          "name": "modelValue",
          "type": "string | null",
          "default": "undefined",
          "required": false,
          "description": "`v-model` value; takes precedence over `value` when bound.",
          "descriptionFrom": "source"
        },
        {
          "name": "value",
          "type": "string | null",
          "default": "null",
          "required": false,
          "description": "Selected tab value. `null` falls back to the first enabled tab.",
          "descriptionFrom": "source"
        },
        {
          "name": "activationMode",
          "type": "ActivationMode",
          "default": "\"automatic\"",
          "required": false,
          "description": "`automatic` (default): arrows select while moving. `manual`: Enter/Space selects.",
          "descriptionFrom": "source"
        },
        {
          "name": "label",
          "type": "string",
          "default": null,
          "required": true,
          "description": "Accessible name for the tab list (announced by screen readers).",
          "descriptionFrom": "source"
        },
        {
          "name": "onValueChange",
          "type": "(value: string) => void",
          "default": "undefined",
          "required": false,
          "description": "Called whenever the selected tab changes.",
          "descriptionFrom": "source"
        }
      ],
      "emits": [
        {
          "name": "update:modelValue",
          "payload": "value: string"
        }
      ],
      "slots": [
        "panel"
      ]
    },
    "elements": {
      "import": {
        "kind": "element",
        "name": "ds-tabs",
        "specifier": "@design-system/elements/define"
      },
      "attributes": [
        {
          "name": "label",
          "reactive": true,
          "required": true,
          "description": "",
          "descriptionFrom": "none"
        },
        {
          "name": "value",
          "reactive": true,
          "required": false,
          "description": "",
          "descriptionFrom": "none"
        }
      ],
      "notes": []
    }
  }
}
