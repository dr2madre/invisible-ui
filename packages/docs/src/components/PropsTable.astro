---
/**
 * PropsTable — a component's API, one tab per adapter that ships it, read from
 * the auto-generated manifest (packages/docs/src/generated/props/<component>.json).
 * The manifest is produced by `pnpm api:generate` from each adapter's source
 * (name / type / default / required) merged with curated descriptions, so the
 * tables can never drift from the real components. With a single adapter the
 * table renders on its own, with no tab strip.
 *
 *   import PropsTable from "../../../components/PropsTable.astro";
 *   <PropsTable component="checkbox" />
 */
import { Tabs, TabItem } from "@astrojs/starlight/components";
import FrameworkApi from "./FrameworkApi.astro";
import { FRAMEWORK_LABELS, frameworksOf, loadManifest } from "./frameworks";

const { component } = Astro.props as { component: string };

const data = loadManifest(component);
const ids = data ? frameworksOf(data) : [];
---

{!data && <p>No props.</p>}

{
  data && ids.length === 1 && (
    <FrameworkApi
      api={data.frameworks[ids[0]]!}
      framework={ids[0]}
      selected={data.selected}
    />
  )
}

{
  data && ids.length > 1 && (
    <Tabs syncKey="framework">
      {ids.map((id) => (
        <TabItem label={FRAMEWORK_LABELS[id]}>
          <FrameworkApi api={data.frameworks[id]!} framework={id} selected={data.selected} />
        </TabItem>
      ))}
    </Tabs>
  )
}
