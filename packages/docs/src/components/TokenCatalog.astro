---
// The token catalog: every `--ds-*` custom property the packages ship, read
// from the generated registry. Specimens paint with the live token inside a
// light and a dark scope, so what you see is what the stylesheet does.
import registry from "../generated/tokens/registry.json";
import { specimenCss, type TokenEntry } from "../lib/token-specimens";

const tokens = registry.tokens as TokenEntry[];
const pairings = registry.pairings;
const counts = registry.counts;

const TIERS: { key: string; title: string; blurb: string }[] = [
  {
    key: "brand",
    title: "Brand",
    blurb: "The identity colours. Change these first: everything else re-derives from them.",
  },
  {
    key: "feedback",
    title: "Feedback",
    blurb: "One colour per kind of message: information, success, warning, danger.",
  },
  {
    key: "semantic",
    title: "Roles",
    blurb: "What components actually read. Each one names a job, and most swap between themes.",
  },
  { key: "state", title: "States", blurb: "Overlays laid over a control while it is hovered or pressed." },
  { key: "focus", title: "Focus", blurb: "The ring that shows where the keyboard is, and its measurements." },
  { key: "primitive", title: "Palette", blurb: "The raw scales. Roles point at these; components never do." },
  { key: "radius", title: "Radius", blurb: "How round a shape is, named for the kind of thing it shapes." },
  { key: "elevation", title: "Elevation", blurb: "The shadow that lifts a floating surface off the page." },
  { key: "typography", title: "Type", blurb: "Families, heading sizes, weights and line heights." },
  { key: "sizing", title: "Control size", blurb: "The padding shared by controls so they line up." },
  { key: "other", title: "Other", blurb: "Anything the tiers above do not cover yet." },
];

const groups = TIERS.map((tier) => ({
  ...tier,
  items: tokens.filter((token) => token.tier === tier.key),
})).filter((group) => group.items.length > 0);

const rules = specimenCss(tokens);
const adapterList = Object.keys(registry.adapters).join(", ");
const failing = pairings.filter((pair) => pair.passes.light === false || pair.passes.dark === false);
---

<style is:inline set:html={rules}></style>

<section class="tk" aria-labelledby="tk-heading">
  <h2 id="tk-heading">Every shipped token</h2>
  <p class="tk-lede">
    <strong>{counts.total}</strong> custom properties, identical in all four adapters ({adapterList}).
    <strong>{counts.colors}</strong> are colours and <strong>{counts.withDarkOverride}</strong> change
    between light and dark. Every specimen paints with <code>var(--ds-…)</code> rather than a copied
    colour, so it follows the stylesheet and any override you apply; the value written beside it is
    worked out from the same stylesheet at build time.
  </p>

  <div class="tk-filter" hidden data-tk-filter>
    <label for="tk-search">Filter by name or role</label>
    <input id="tk-search" type="search" autocomplete="off" spellcheck="false" data-tk-search />
  </div>
  <p class="tk-count" aria-live="polite" data-tk-status>{counts.total} tokens</p>

  <nav class="tk-jump" aria-label="Token groups">
    <ul>
      {
        groups.map((group) => (
          <li>
            <a href={`#tk-${group.key}`}>
              {group.title} <span class="tk-jump-count">{group.items.length}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </nav>

  {
    groups.map((group) => (
      <section class="tk-group" aria-labelledby={`tk-${group.key}`}>
        <h3 id={`tk-${group.key}`}>{group.title}</h3>
        <p class="tk-group-blurb">{group.blurb}</p>
        <ul class="tk-list">
          {group.items.map((token) => (
            <li
              class="tk-card"
              data-tk-token
              data-name={token.name}
              data-role={(token.purpose ?? token.group ?? "").toLowerCase()}
            >
              <h4><code>{token.name}</code></h4>
              <p class="tk-role">{token.purpose ?? token.group}</p>
              <ul class="tk-tags">
                <li>{token.ownership === "design" ? "design owned" : "theme layer"}</li>
                <li>{token.stability}</li>
                {token.hasAlpha && <li>see-through</li>}
                {token.source.dtcg && <li>in the design source</li>}
              </ul>
              {
                token.replacedBy && (
                  <p class="tk-deprecated">
                    Use <code>{token.replacedBy}</code> instead. This name keeps resolving to it and
                    goes away before 1.0.
                  </p>
                )
              }

              <div class="tk-specimens">
                {["light", "dark"].map((theme) => (
                  <figure class="tk-pane" data-theme={theme}>
                    <div class={`tk-plate tk-plate--${token.specimenKind}`}>
                      <div class={`tk-specimen tk-specimen--${token.specimenKind}`} data-token={token.id}>
                        {token.specimenKind === "text" ? "Handgloves 123" : ""}
                      </div>
                    </div>
                    <figcaption>
                      <span class="tk-theme">{theme === "light" ? "Light" : "Dark"}</span>
                      <code>
                        {token.resolved[theme as "light" | "dark"] ??
                          (theme === "dark"
                            ? (token.expressions.darkAttr ??
                              token.expressions.darkMedia ??
                              token.expressions.light)
                            : token.expressions.light)}
                      </code>
                    </figcaption>
                  </figure>
                ))}
              </div>

              <dl class="tk-facts">
                <dt>Light</dt>
                <dd><code>{token.expressions.light}</code></dd>
                {(token.expressions.darkAttr ?? token.expressions.darkMedia) && (
                  <Fragment>
                    <dt>Dark</dt>
                    <dd>
                      <code>{token.expressions.darkAttr ?? token.expressions.darkMedia}</code>
                    </dd>
                  </Fragment>
                )}
                {token.replacedBy && (
                  <Fragment>
                    <dt>Replaced by</dt>
                    <dd>
                      <code>{token.replacedBy}</code>
                    </dd>
                  </Fragment>
                )}
                {token.aliasChain.length > 0 && (
                  <Fragment>
                    <dt>Points at</dt>
                    <dd>{token.aliasChain.join(" → ")}</dd>
                  </Fragment>
                )}
                {token.expressions.fallbackLight && (
                  <Fragment>
                    <dt>Without color-mix</dt>
                    <dd><code>{token.expressions.fallbackLight}</code></dd>
                  </Fragment>
                )}
                <dt>Defined at</dt>
                <dd>
                  {token.source.file}:{token.source.line}
                </dd>
              </dl>
            </li>
          ))}
        </ul>
      </section>
    ))
  }

  <section class="tk-group" aria-labelledby="tk-contrast">
    <h3 id="tk-contrast">Contrast of the pairs components actually use</h3>
    <p class="tk-group-blurb">
      Measured from the stylesheet, not from a screenshot. Normal text needs 4.5:1 and a boundary or a
      glyph needs 3:1. The boundary measured here is <code>--ds-color-control-border</code>, the one
      that identifies a control; the generic <code>--ds-color-border</code> draws dividers and panel
      edges, which the criterion does not cover. A pair that does not reach its target is named below
      the table as well, so the result never depends on reading a colour.
    </p>
    <div class="tk-scroll" role="region" aria-labelledby="tk-contrast" tabindex="0">
      <table class="tk-table">
        <caption>Foreground over background, per theme</caption>
        <thead>
          <tr>
            <th scope="col">Pair</th>
            <th scope="col">Needs</th>
            <th scope="col">Light</th>
            <th scope="col">Dark</th>
          </tr>
        </thead>
        <tbody>
          {
            pairings.map((pair) => (
              <tr>
                <th scope="row">
                  {pair.what}
                  <span class="tk-pair"><code>{pair.front}</code> over <code>{pair.back}</code></span>
                </th>
                <td>{pair.min}:1</td>
                <td>
                  {pair.light}:1 <span class="tk-verdict">{pair.passes.light ? "meets" : "below"}</span>
                </td>
                <td>
                  {pair.dark}:1 <span class="tk-verdict">{pair.passes.dark ? "meets" : "below"}</span>
                </td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
    {
      failing.length > 0 && (
        <div class="tk-open">
          <h4>Open in this alpha</h4>
          <ul>
            {failing.map((pair) => (
              <li>
                <strong>{pair.what}</strong>: {pair.passes.light === false && `light ${pair.light}:1`}
                {pair.passes.light === false && pair.passes.dark === false && ", "}
                {pair.passes.dark === false && `dark ${pair.dark}:1`}, against a target of {pair.min}:1.
              </li>
            ))}
          </ul>
          <p>
            These are recorded rather than hidden. The default theme is alpha and the boundary colour is
            under review; if you ship on it, set your own value for the tokens named above.
          </p>
        </div>
      )
    }
  </section>
</section>

<script>
  // Progressive filter: the field is hidden in the markup and revealed here, so
  // nobody gets a control that cannot work.
  const filter = document.querySelector<HTMLElement>("[data-tk-filter]");
  const search = document.querySelector<HTMLInputElement>("[data-tk-search]");
  const status = document.querySelector<HTMLElement>("[data-tk-status]");
  const cards = Array.from(document.querySelectorAll<HTMLElement>("[data-tk-token]"));

  if (filter && search && status && cards.length > 0) {
    filter.hidden = false;
    const total = cards.length;
    const apply = () => {
      const query = search.value.trim().toLowerCase();
      let shown = 0;
      for (const card of cards) {
        const haystack = `${card.dataset.name ?? ""} ${card.dataset.role ?? ""}`;
        const match = query === "" || haystack.includes(query);
        card.hidden = !match;
        if (match) shown += 1;
      }
      for (const group of document.querySelectorAll<HTMLElement>(".tk-group")) {
        const items = group.querySelectorAll("[data-tk-token]");
        if (items.length === 0) continue;
        group.hidden = Array.from(items).every((item) => (item as HTMLElement).hidden);
        // A link to a group nobody can see would go nowhere.
        const link = document.querySelector<HTMLElement>(`.tk-jump a[href="#${group.querySelector("h3")?.id}"]`);
        if (link?.parentElement) link.parentElement.hidden = group.hidden;
      }
      status.textContent =
        query === "" ? `${total} tokens` : `${shown} of ${total} tokens match “${query}”`;
    };
    search.addEventListener("input", apply);
  }
</script>

<style>
  .tk {
    margin-block-start: 1.5rem;
  }
  /* The grids below set `display`, which would otherwise beat the browser's own
     rule for `hidden` and leave hidden things on screen. */
  .tk [hidden],
  .tk-group[hidden] {
    display: none;
  }
  .tk-lede {
    max-inline-size: 60ch;
  }
  .tk-filter {
    display: grid;
    gap: 0.35rem;
    max-inline-size: 28rem;
    margin-block: 1.5rem;
  }
  .tk-filter label {
    font-size: 0.875rem;
    font-weight: 600;
  }
  .tk-filter input {
    font: inherit;
    padding: 0.45rem 0.6rem;
    color: var(--ds-color-text);
    background: var(--ds-color-background);
    border: 1px solid var(--ds-color-border);
    border-radius: var(--ds-radius-control);
    min-block-size: 2.75rem;
  }
  .tk-filter input:focus-visible {
    outline: var(--ds-focus-ring-width) solid var(--ds-color-focus-ring);
    outline-offset: 2px;
  }
  .tk-count {
    margin: 0;
    font-size: 0.8125rem;
    color: var(--ds-color-text-secondary);
  }
  .tk-jump ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    padding: 0;
    margin: 0 0 2rem;
    list-style: none;
  }
  .tk-jump a {
    display: inline-flex;
    gap: 0.35rem;
    align-items: center;
    padding: 0.35rem 0.7rem;
    font-size: 0.8125rem;
    text-decoration: none;
    border: 1px solid var(--ds-color-border);
    border-radius: var(--ds-radius-pill);
    min-block-size: 2.25rem;
  }
  .tk-jump-count {
    font-variant-numeric: tabular-nums;
    color: var(--ds-color-text-secondary);
  }
  .tk-group {
    margin-block-end: 2.5rem;
  }
  .tk-group-blurb {
    max-inline-size: 60ch;
  }
  .tk-list {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 17rem), 1fr));
    gap: 1rem;
    padding: 0;
    margin: 0;
    list-style: none;
  }
  .tk-card {
    display: grid;
    gap: 0.5rem;
    align-content: start;
    padding: 0.85rem;
    border: 1px solid var(--ds-color-border);
    border-radius: var(--ds-radius-surface);
  }
  .tk-card h4 {
    margin: 0;
    font-size: 0.875rem;
  }
  .tk-card h4 code {
    overflow-wrap: anywhere;
  }
  .tk-role {
    margin: 0;
    font-size: 0.8125rem;
    color: var(--ds-color-text-secondary);
  }
  .tk-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem;
    padding: 0;
    margin: 0;
    list-style: none;
  }
  .tk-deprecated {
    margin: 0;
    padding: 0.4rem 0.6rem;
    font-size: 0.75rem;
    border: 1px solid var(--ds-color-border);
    border-inline-start: 3px solid var(--ds-color-control-border);
    border-radius: var(--ds-radius-control);
  }
  .tk-deprecated code {
    overflow-wrap: anywhere;
  }
  .tk-tags li {
    padding: 0.1rem 0.45rem;
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    border: 1px solid var(--ds-color-border);
    border-radius: var(--ds-radius-pill);
  }
  .tk-specimens {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.5rem;
  }
  .tk-pane {
    display: grid;
    gap: 0.3rem;
    padding: 0.4rem;
    margin: 0;
    background: var(--ds-color-background);
    color: var(--ds-color-text);
    border: 1px solid var(--ds-color-border);
    border-radius: var(--ds-radius-control);
  }
  .tk-pane figcaption {
    display: grid;
    gap: 0.1rem;
    font-size: 0.6875rem;
  }
  .tk-theme {
    font-weight: 600;
  }
  /* The pane shows one theme, so its code chips have to take their colours
     from that theme and not from the page around them. */
  .tk-pane code {
    font-size: 0.6875rem;
    overflow-wrap: anywhere;
    color: var(--ds-color-text);
    background: var(--ds-color-surface);
    border-color: var(--ds-color-border);
  }
  /* The plate sits under the specimen. Its chequerboard shows through a
     see-through token, so 30% purple does not read as solid. */
  .tk-plate {
    display: grid;
    border: 1px solid var(--ds-color-border);
    border-radius: var(--ds-radius-control);
    overflow: hidden;
  }
  .tk-plate--color {
    background-image:
      linear-gradient(45deg, var(--ds-color-surface) 25%, transparent 25%),
      linear-gradient(-45deg, var(--ds-color-surface) 25%, transparent 25%),
      linear-gradient(45deg, transparent 75%, var(--ds-color-surface) 75%),
      linear-gradient(-45deg, transparent 75%, var(--ds-color-surface) 75%);
    background-size: 0.75rem 0.75rem;
    background-position:
      0 0,
      0 0.375rem,
      0.375rem -0.375rem,
      -0.375rem 0;
  }
  .tk-plate--radius,
  .tk-plate--shadow {
    padding: 0.5rem;
  }
  .tk-plate--size {
    justify-items: start;
    align-content: center;
    padding: 0.5rem;
  }
  .tk-specimen {
    display: grid;
    place-items: center;
    min-block-size: 2.75rem;
    /* A swatch has to show the real colour even when the system replaces
       colours, or this page says something untrue. Nothing is lost: the value
       is written out next to every specimen. */
    forced-color-adjust: none;
  }
  .tk-specimen--radius,
  .tk-specimen--shadow {
    background-color: var(--ds-color-surface);
    border: 1px solid var(--ds-color-border);
  }
  .tk-specimen--size {
    background-color: var(--ds-color-text-secondary);
    min-block-size: 0.75rem;
  }
  .tk-specimen--text,
  .tk-specimen--value {
    padding: 0.35rem;
  }
  .tk-facts {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.15rem 0.5rem;
    margin: 0;
    font-size: 0.75rem;
  }
  .tk-facts dt {
    font-weight: 600;
    color: var(--ds-color-text-secondary);
  }
  .tk-facts dd {
    margin: 0;
    overflow-wrap: anywhere;
  }
  .tk-facts code {
    font-size: 0.6875rem;
  }
  .tk-scroll {
    overflow-x: auto;
  }
  .tk-table {
    inline-size: 100%;
    border-collapse: collapse;
    font-size: 0.8125rem;
  }
  .tk-table caption {
    text-align: start;
    padding-block-end: 0.4rem;
    color: var(--ds-color-text-secondary);
  }
  .tk-table th,
  .tk-table td {
    text-align: start;
    padding: 0.4rem 0.6rem;
    border-block-end: 1px solid var(--ds-color-border);
    vertical-align: top;
  }
  .tk-pair {
    display: block;
    font-weight: 400;
    font-size: 0.6875rem;
    color: var(--ds-color-text-secondary);
  }
  .tk-verdict {
    display: block;
    font-size: 0.6875rem;
  }
  .tk-open {
    padding: 0.85rem;
    margin-block-start: 1rem;
    border: 1px solid var(--ds-color-border);
    border-radius: var(--ds-radius-surface);
  }
  .tk-open h4 {
    margin-block: 0 0.4rem;
    font-size: 0.9375rem;
  }
  .tk-open p {
    margin-block-end: 0;
    max-inline-size: 60ch;
  }
  @media (max-width: 30rem) {
    .tk-specimens {
      grid-template-columns: 1fr;
    }
  }
</style>
