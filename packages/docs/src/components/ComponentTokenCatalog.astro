---
// The component-token catalog: the third theming tier. These names are never
// defined in a stylesheet — each lives inside the var() references of the
// components that read it, and the fallback written there is the shipped
// default. Everything on this page comes from the generated registry.
import registry from "../generated/tokens/registry.json";

interface ComponentToken {
  name: string;
  id: string;
  component: string;
  usedBy: string[];
  category: string;
  properties: string[];
  adapters: string[];
  fallbacks: string[];
  parents: string[];
  sites: { adapter: string; file: string; selector: string; property: string }[];
  purpose: string | null;
  stability: string;
  replacedBy: string | null;
}

const tokens = registry.componentTokens as ComponentToken[];
const byComponent = new Map<string, ComponentToken[]>();
for (const token of tokens) {
  const list = byComponent.get(token.component) ?? [];
  list.push(token);
  byComponent.set(token.component, list);
}
const groups = [...byComponent.entries()].sort(([a], [b]) => (a < b ? -1 : 1));

// Specimens only where a value is worth seeing; painted through the same
// var() expression the component uses, so nothing here is a copied value.
const SPECIMEN_CATEGORIES = new Set(["color", "radius", "shadow"]);
const rules = tokens
  .filter((token) => SPECIMEN_CATEGORIES.has(token.category) && token.fallbacks.length > 0)
  .map((token) => {
    const property =
      // The shorthand, so a gradient fallback renders instead of being an
      // invalid background-color.
      token.category === "color"
        ? "background"
        : token.category === "radius"
          ? "border-radius"
          : "box-shadow";
    return `.ctk-specimen[data-token="${token.id}"]{${property}:var(${token.name}, ${token.fallbacks[0]})}`;
  })
  .join("\n");

const counts = {
  total: tokens.length,
  components: byComponent.size,
  withParent: tokens.filter((token) => token.parents.length > 0).length,
};
---

<style is:inline set:html={rules}></style>

<section class="ctk" aria-labelledby="ctk-heading">
  <h2 id="ctk-heading">Every component knob</h2>
  <p class="ctk-lede">
    <strong>{counts.total}</strong> knobs across <strong>{counts.components}</strong> components.
    None of these is defined in a stylesheet: the fallback written at the point of use is the
    shipped default, and setting the custom property on any scope overrides it everywhere that
    component reads it. <strong>{counts.withParent}</strong> knobs fall back through a semantic
    role, so retheming the role restyles them for free.
  </p>

  <div class="ctk-filter" hidden data-ctk-filter>
    <label for="ctk-search">Filter by name, component or role</label>
    <input id="ctk-search" type="search" autocomplete="off" spellcheck="false" data-ctk-search />
  </div>
  <p class="ctk-count" aria-live="polite" data-ctk-status>{counts.total} knobs</p>

  {
    groups.map(([component, items]) => (
      <section class="ctk-group" aria-labelledby={`ctk-${component}`}>
        <h3 id={`ctk-${component}`}>
          {component} <span class="ctk-group-count">{items.length}</span>
        </h3>
        <ul class="ctk-list">
          {items.map((token) => (
            <li
              class="ctk-card"
              data-ctk-token
              data-name={token.name}
              data-role={`${token.component} ${(token.purpose ?? "").toLowerCase()} ${token.parents.join(" ")}`}
            >
              <h4>
                <code>{token.name}</code>
              </h4>
              {token.purpose && <p class="ctk-role">{token.purpose}</p>}
              <ul class="ctk-tags">
                <li>{token.category}</li>
                <li>{token.adapters.join(" · ")}</li>
                <li>{token.stability}</li>
              </ul>
              {SPECIMEN_CATEGORIES.has(token.category) && token.fallbacks.length > 0 && (
                <div class="ctk-panes">
                  {["light", "dark"].map((theme) => (
                    <figure class="ctk-pane" data-theme={theme}>
                      <div class="ctk-plate">
                        <div class="ctk-specimen" data-token={token.id} />
                      </div>
                      <figcaption>{theme === "light" ? "Light" : "Dark"}</figcaption>
                    </figure>
                  ))}
                </div>
              )}
              <dl class="ctk-facts">
                <dt>Default</dt>
                <dd>
                  {token.fallbacks.map((fallback) => (
                    <code class="ctk-fallback">{fallback}</code>
                  ))}
                </dd>
                {token.parents.length > 0 && (
                  <Fragment>
                    <dt>Follows</dt>
                    <dd>{token.parents.join(", ")}</dd>
                  </Fragment>
                )}
                <dt>Controls</dt>
                <dd>{token.properties.join(", ")}</dd>
                <dt>Read in</dt>
                <dd>
                  {token.sites.length} place{token.sites.length === 1 ? "" : "s"} across{" "}
                  {token.usedBy.join(", ")}
                </dd>
              </dl>
            </li>
          ))}
        </ul>
      </section>
    ))
  }
</section>

<script>
  // Progressive filter, same pattern as the token catalog: revealed only when
  // it can work, and the status line always matches the page.
  const filter = document.querySelector<HTMLElement>("[data-ctk-filter]");
  const search = document.querySelector<HTMLInputElement>("[data-ctk-search]");
  const status = document.querySelector<HTMLElement>("[data-ctk-status]");
  const cards = Array.from(document.querySelectorAll<HTMLElement>("[data-ctk-token]"));

  if (filter && search && status && cards.length > 0) {
    filter.hidden = false;
    const total = cards.length;
    const apply = () => {
      const query = search.value.trim().toLowerCase();
      let shown = 0;
      for (const card of cards) {
        const haystack = `${card.dataset.name ?? ""} ${card.dataset.role ?? ""}`;
        const match = query === "" || haystack.includes(query);
        card.hidden = !match;
        if (match) shown += 1;
      }
      for (const group of document.querySelectorAll<HTMLElement>(".ctk-group")) {
        const items = group.querySelectorAll("[data-ctk-token]");
        group.hidden = Array.from(items).every((item) => (item as HTMLElement).hidden);
      }
      status.textContent = query === "" ? `${total} knobs` : `${shown} of ${total} knobs match “${query}”`;
    };
    search.addEventListener("input", apply);
  }
</script>

<style>
  .ctk [hidden],
  .ctk-group[hidden] {
    display: none;
  }
  .ctk-lede {
    max-inline-size: 60ch;
  }
  .ctk-filter {
    display: grid;
    gap: 0.35rem;
    max-inline-size: 28rem;
    margin-block: 1.5rem 0.5rem;
  }
  .ctk-filter label {
    font-size: 0.875rem;
    font-weight: 600;
  }
  .ctk-filter input {
    font: inherit;
    padding: 0.45rem 0.6rem;
    color: var(--ds-color-text);
    background: var(--ds-color-background);
    border: 1px solid var(--ds-color-control-border);
    border-radius: var(--ds-radius-control);
    min-block-size: 2.75rem;
  }
  .ctk-filter input:focus-visible {
    outline: var(--ds-focus-ring-width) solid var(--ds-color-focus-ring);
    outline-offset: 2px;
  }
  .ctk-count {
    margin: 0 0 1rem;
    font-size: 0.8125rem;
    color: var(--ds-color-text-secondary);
  }
  .ctk-group {
    margin-block-end: 2rem;
  }
  .ctk-group-count {
    font-size: 0.8125rem;
    font-weight: 400;
    color: var(--ds-color-text-secondary);
  }
  .ctk-list {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 19rem), 1fr));
    gap: 0.9rem;
    padding: 0;
    margin: 0;
    list-style: none;
  }
  .ctk-card {
    display: grid;
    gap: 0.45rem;
    align-content: start;
    padding: 0.8rem;
    border: 1px solid var(--ds-color-border);
    border-radius: var(--ds-radius-surface);
  }
  .ctk-card h4 {
    margin: 0;
    font-size: 0.8125rem;
  }
  .ctk-card h4 code {
    overflow-wrap: anywhere;
  }
  .ctk-role {
    margin: 0;
    font-size: 0.78rem;
    color: var(--ds-color-text-secondary);
  }
  .ctk-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem;
    padding: 0;
    margin: 0;
    list-style: none;
  }
  .ctk-tags li {
    padding: 0.05rem 0.4rem;
    font-size: 0.65rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    border: 1px solid var(--ds-color-border);
    border-radius: var(--ds-radius-pill);
  }
  .ctk-panes {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.4rem;
  }
  .ctk-pane {
    display: grid;
    gap: 0.2rem;
    padding: 0.3rem;
    margin: 0;
    background: var(--ds-color-background);
    color: var(--ds-color-text);
    border: 1px solid var(--ds-color-border);
    border-radius: var(--ds-radius-control);
  }
  .ctk-pane figcaption {
    font-size: 0.65rem;
  }
  .ctk-plate {
    display: grid;
    border: 1px solid var(--ds-color-border);
    border-radius: var(--ds-radius-control);
    overflow: hidden;
    background-image:
      linear-gradient(45deg, var(--ds-color-surface) 25%, transparent 25%),
      linear-gradient(-45deg, var(--ds-color-surface) 25%, transparent 25%),
      linear-gradient(45deg, transparent 75%, var(--ds-color-surface) 75%),
      linear-gradient(-45deg, transparent 75%, var(--ds-color-surface) 75%);
    background-size: 0.75rem 0.75rem;
    background-position:
      0 0,
      0 0.375rem,
      0.375rem -0.375rem,
      -0.375rem 0;
  }
  .ctk-specimen {
    min-block-size: 1.8rem;
  }
  .ctk-facts {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.12rem 0.5rem;
    margin: 0;
    font-size: 0.72rem;
  }
  .ctk-facts dt {
    font-weight: 600;
    color: var(--ds-color-text-secondary);
  }
  .ctk-facts dd {
    margin: 0;
    overflow-wrap: anywhere;
  }
  .ctk-fallback {
    display: block;
    font-size: 0.68rem;
  }
  @media (max-width: 30rem) {
    .ctk-panes {
      grid-template-columns: 1fr;
    }
  }
</style>
