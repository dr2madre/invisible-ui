      "default": { "$value": "{palette.orange.500}" }
    },
    "danger": {
      "default": { "$value": "{palette.red.600}" },
      "hover": { "$value": "{palette.red.700}" }
    },
    "focus": {
      "onDark": {
        "$value": "#a286db",
        "$description": "Focus ring on dark surfaces: secondary mixed 70% with white, as --ds-color-focus-ring in dark mode. The primary reaches only 2.87:1 on grey 900.",
        "$extensions": {
          "com.invisible-ui.mix": {
            "space": "srgb",
            "base": "{style.secondary.default}",
            "amount": 0.7,
            "with": "{palette.grey.0}"
          }
        }
      }
    }
  },
  "radius": {
    "$type": "dimension",
    "control": { "$value": "0.5rem" },
    "surface": { "$value": "0.75rem" },
    "pill": { "$value": "999px" }
  },
