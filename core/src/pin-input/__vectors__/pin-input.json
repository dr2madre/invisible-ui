{
  "description": "PIN input values, language-neutral: splitValue(value, length), sanitizeChar(char, type) and keyTarget(key, index, length, direction) in core/src/pin-input/state.ts, and paste: what the onPaste handler of connect.ts commits and focuses when text is pasted into the cell at index (null when it commits nothing). Arabic-Indic and Persian digits are accepted and come back as ASCII digits. keys: the cell a key moves the focus to (null for a key that moves nothing); the arrows follow the layout, so in a right-to-left one ArrowLeft goes to the next cell. The core tests and the Flutter tests read this file, so both implementations answer the same cases.",
  "split": [
    {
      "name": "Fills from the first cell",
      "value": "12",
      "length": 4,
      "expect": ["1", "2", "", ""]
    },
    {
      "name": "A full value",
      "value": "1234",
      "length": 4,
      "expect": ["1", "2", "3", "4"]
    },
    {
      "name": "Longer than the cells: cut",
      "value": "123456",
      "length": 4,
      "expect": ["1", "2", "3", "4"]
    },
    {
      "name": "Empty",
      "value": "",
      "length": 3,
      "expect": ["", "", ""]
    }
  ],
  "sanitize": [
    {
      "name": "A digit, numeric",
      "char": "5",
      "type": "numeric",
      "expect": "5"
    },
    {
      "name": "A letter, numeric",
      "char": "a",
      "type": "numeric",
      "expect": ""
    },
    {
      "name": "A letter, alphanumeric",
      "char": "a",
      "type": "alphanumeric",
      "expect": "a"
    },
    {
      "name": "An upper-case letter, alphanumeric",
      "char": "Q",
      "type": "alphanumeric",
      "expect": "Q"
    },
    {
      "name": "A symbol, alphanumeric",
      "char": "@",
      "type": "alphanumeric",
      "expect": ""
    },
    {
      "name": "A space, numeric",
      "char": " ",
      "type": "numeric",
      "expect": ""
    },
    {
      "name": "An Arabic-Indic digit, numeric",
      "char": "٣",
      "type": "numeric",
      "expect": "3"
    },
    {
      "name": "A Persian digit, numeric",
      "char": "۷",
      "type": "numeric",
      "expect": "7"
    },
    {
      "name": "An Arabic-Indic zero, alphanumeric",
      "char": "٠",
      "type": "alphanumeric",
      "expect": "0"
    },
    {
      "name": "A Persian digit, alphanumeric",
      "char": "۹",
      "type": "alphanumeric",
      "expect": "9"
    },
    {
      "name": "An Arabic letter, numeric",
      "char": "ب",
      "type": "numeric",
      "expect": ""
    },
    {
      "name": "An Arabic letter, alphanumeric",
      "char": "ب",
      "type": "alphanumeric",
      "expect": ""
    },
    {
      "name": "The Arabic decimal separator, numeric",
      "char": "٫",
      "type": "numeric",
      "expect": ""
    }
  ],
  "paste": [
    {
      "name": "Fills from the first cell",
      "values": ["", "", "", ""],
      "index": 0,
      "text": "1234",
      "type": "numeric",
      "expect": {
        "values": ["1", "2", "3", "4"],
        "focus": 3
      }
    },
    {
      "name": "Fills from the focused cell",
      "values": ["9", "", "", ""],
      "index": 1,
      "text": "12",
      "type": "numeric",
      "expect": {
        "values": ["9", "1", "2", ""],
        "focus": 3
      }
    },
    {
      "name": "Drops the characters the type refuses",
      "values": ["", "", "", ""],
      "index": 0,
      "text": "1-2 3a4",
      "type": "numeric",
      "expect": {
        "values": ["1", "2", "3", "4"],
        "focus": 3
      }
    },
    {
      "name": "Stops at the last cell",
      "values": ["", "", "", ""],
      "index": 2,
      "text": "123456",
      "type": "numeric",
      "expect": {
        "values": ["", "", "1", "2"],
        "focus": 3
      }
    },
    {
      "name": "Nothing allowed changes nothing",
      "values": ["1", "", "", ""],
      "index": 0,
      "text": "abc",
      "type": "numeric",
      "expect": null
    },
    {
      "name": "Letters, alphanumeric",
      "values": ["", "", "", ""],
      "index": 0,
      "text": "a1-B2",
      "type": "alphanumeric",
      "expect": {
        "values": ["a", "1", "B", "2"],
        "focus": 3
      }
    },
    {
      "name": "Arabic-Indic digits fill as ASCII",
      "values": ["", "", "", ""],
      "index": 0,
      "text": "١٢٣٤",
      "type": "numeric",
      "expect": {
        "values": ["1", "2", "3", "4"],
        "focus": 3
      }
    },
    {
      "name": "Persian, Arabic-Indic and ASCII digits mixed",
      "values": ["", "", "", ""],
      "index": 0,
      "text": "۱-2 ٣۴",
      "type": "numeric",
      "expect": {
        "values": ["1", "2", "3", "4"],
        "focus": 3
      }
    }
  ],
  "keys": [
    {
      "name": "ArrowRight moves to the next cell, left to right",
      "key": "ArrowRight",
      "index": 1,
      "length": 4,
      "direction": "ltr",
      "expect": 2
    },
    {
      "name": "ArrowLeft moves to the previous cell, left to right",
      "key": "ArrowLeft",
      "index": 1,
      "length": 4,
      "direction": "ltr",
      "expect": 0
    },
    {
      "name": "ArrowLeft moves to the next cell, right to left",
      "key": "ArrowLeft",
      "index": 1,
      "length": 4,
      "direction": "rtl",
      "expect": 2
    },
    {
      "name": "ArrowRight moves to the previous cell, right to left",
      "key": "ArrowRight",
      "index": 1,
      "length": 4,
      "direction": "rtl",
      "expect": 0
    },
    {
      "name": "ArrowLeft stays on the last cell, right to left",
      "key": "ArrowLeft",
      "index": 3,
      "length": 4,
      "direction": "rtl",
      "expect": 3
    },
    {
      "name": "ArrowRight stays on the first cell, right to left",
      "key": "ArrowRight",
      "index": 0,
      "length": 4,
      "direction": "rtl",
      "expect": 0
    },
    {
      "name": "ArrowRight stays on the last cell, left to right",
      "key": "ArrowRight",
      "index": 3,
      "length": 4,
      "direction": "ltr",
      "expect": 3
    },
    {
      "name": "ArrowLeft stays on the first cell, left to right",
      "key": "ArrowLeft",
      "index": 0,
      "length": 4,
      "direction": "ltr",
      "expect": 0
    },
    {
      "name": "Home goes to the first cell, right to left",
      "key": "Home",
      "index": 2,
      "length": 4,
      "direction": "rtl",
      "expect": 0
    },
    {
      "name": "End goes to the last cell, right to left",
      "key": "End",
      "index": 1,
      "length": 4,
      "direction": "rtl",
      "expect": 3
    },
    {
      "name": "Home goes to the first cell, left to right",
      "key": "Home",
      "index": 2,
      "length": 4,
      "direction": "ltr",
      "expect": 0
    },
    {
      "name": "End goes to the last cell, left to right",
      "key": "End",
      "index": 1,
      "length": 4,
      "direction": "ltr",
      "expect": 3
    },
    {
      "name": "ArrowUp moves nothing",
      "key": "ArrowUp",
      "index": 1,
      "length": 4,
      "direction": "ltr",
      "expect": null
    },
    {
      "name": "A character moves nothing",
      "key": "5",
      "index": 1,
      "length": 4,
      "direction": "rtl",
      "expect": null
    }
  ]
}
