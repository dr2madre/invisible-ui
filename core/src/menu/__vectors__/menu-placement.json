        "width": 180,
        "height": 240
      },
      "viewport": {
        "width": 800,
        "height": 600
      },
      "direction": "ltr",
      "expect": {
        "side": "inline-start",
        "physicalSide": "left",
        "x": 320,
        "y": 50,
        "maxHeight": 584
      }
    },
    {
      "name": "Opens at inline-end (left) in right-to-left",
