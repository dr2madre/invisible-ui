{
  "description": "Submenu placement (docs/menu-submenu-spec.md, Positioning): inline-end of the trigger, top aligned; inline-start when inline-end has no room; overlapping the parent, shifted inside the viewport, when neither side has room. 8 px padding at the viewport edges.",
  "padding": 8,
  "cases": [
    {
      "name": "Opens at inline-end in left-to-right",
      "anchor": {
        "x": 100,
        "y": 50,
        "width": 200,
        "height": 32
      },
      "menu": {
        "width": 180,
        "height": 240
      },
      "viewport": {
        "width": 800,
        "height": 600
      },
      "direction": "ltr",
      "expect": {
        "side": "inline-end",
        "physicalSide": "right",
        "x": 300,
        "y": 50,
        "maxHeight": 584
      }
    },
    {
      "name": "Flips to inline-start near the right edge",
