{
  "description": "Slider values, language-neutral: snap(value, min, max, step), percentage(state) of a state holding { value, min, max } as given, and valueFromFraction(state, fraction) for a state holding { min, max, step }, in core/src/slider/state.ts. Numbers compare to within 1e-9. The core tests and the Flutter tests read this file, so both implementations answer the same cases.",
  "snap": [
    {
      "name": "A value on the grid stays",
      "value": 40,
      "min": 0,
      "max": 100,
      "step": 1,
      "expect": 40
    },
    {
      "name": "Rounds to the nearest step",
      "value": 7,
      "min": 0,
      "max": 100,
      "step": 5,
      "expect": 5
    },
    {
      "name": "Half a step rounds up",
      "value": 7.5,
      "min": 0,
      "max": 100,
      "step": 5,
      "expect": 10
    },
    {
      "name": "Below the minimum clamps to it",
      "value": -5,
      "min": 0,
      "max": 100,
      "step": 1,
      "expect": 0
    },
    {
      "name": "Above the maximum clamps to it",
      "value": 999,
      "min": 0,
      "max": 100,
      "step": 1,
      "expect": 100
    },
    {
      "name": "A fractional step leaves no drift",
      "value": 0.27,
      "min": 0,
      "max": 1,
      "step": 0.1,
      "expect": 0.3
    },
    {
      "name": "The grid is anchored at the minimum",
      "value": 12,
      "min": 3,
      "max": 30,
      "step": 4,
      "expect": 11
    },
    {
      "name": "A maximum the grid does not reach stays reachable",
      "value": 99,
      "min": 0,
      "max": 95,
      "step": 10,
      "expect": 95
    },
    {
      "name": "A negative range",
      "value": -2.5,
      "min": -10,
      "max": 0,
      "step": 5,
      "expect": 0
    },
    {
      "name": "No step: only the clamp applies",
      "value": 33.3,
      "min": 0,
      "max": 100,
      "step": 0,
      "expect": 33.3
    }
  ],
  "percentage": [
    {
