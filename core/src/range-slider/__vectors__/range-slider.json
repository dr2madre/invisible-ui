{
  "description": "Range slider values, language-neutral: snap, effectiveMinDistance, clampPair, normalizePair and orderBounds in core/src/range-slider/state.ts, and nearerThumb and pointerFraction in geometry.ts, the pointer cases on the box { left: 10, top: 0, width: 200, height: 100 }. Numbers compare to within 1e-9. The core tests and the Flutter tests read this file, so both implementations answer the same cases.",
  "snap": [
    {
      "name": "A value on the grid stays",
      "value": 40,
      "min": 0,
      "max": 100,
      "step": 1,
      "expect": 40
    },
    {
      "name": "Rounds to the nearest step",
      "value": 7,
      "min": 0,
      "max": 100,
      "step": 5,
      "expect": 5
    },
    {
      "name": "Past a maximum the grid does not reach, steps down",
      "value": 99,
      "min": 0,
      "max": 95,
      "step": 10,
      "expect": 90
    },
    {
      "name": "Below the minimum clamps to it",
      "value": -3,
      "min": 0,
      "max": 100,
      "step": 1,
      "expect": 0
    },
    {
      "name": "A fractional step leaves no drift",
      "value": 0.6000000000000001,
      "min": 0,
      "max": 1,
      "step": 0.1,
      "expect": 0.6
    },
    {
      "name": "No step: only the clamp applies",
      "value": 101,
      "min": 0,
      "max": 100,
      "step": 0,
      "expect": 100
    }
  ],
