@@ -58,7 +58,15 @@ function getEnumerableOwnPropertySymbols(target) {
 }
 
 function getKeys(target) {
-	return Object.keys(target).concat(getEnumerableOwnPropertySymbols(target))
+	// GHSA-gcqx-w48m-w2h4: assigning a key named __proto__ replaces the
+	// prototype of the object being built instead of adding a property to it,
+	// so a source carrying that key poisons what merge returns. The guard
+	// below only covers a target that has the key on its prototype chain; a
+	// target made with Object.create(null) does not, and the assignment goes
+	// through. The key is dropped here, for the target and the source alike.
+	return Object.keys(target).filter(function(key) {
+		return key !== '__proto__'
+	}).concat(getEnumerableOwnPropertySymbols(target))
 }
 
 function propertyIsOnObject(object, property) {
