{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [
    "scripts/source-hash.mjs",
    "scripts/build-id.mjs",
    "scripts/write-build-info.mjs",
    "tsconfig.base.json"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    // The parity tests read files outside their package: the design source
    // for svelte, another package's stylesheets for react, vue and elements.
    // Declared as inputs so a cache hit is never replayed over a change to them.
    "@design-system/svelte#test": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/packages/tokens/tokens.json"]
    },
    "@design-system/react#test": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/packages/svelte/src/lib/styles/tokens.css"]
    },
    "@design-system/vue#test": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/packages/react/src/styles/**"]
    },
    "@design-system/elements#test": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/packages/react/src/styles/**",
        "$TURBO_ROOT$/packages/vue/src/styles/**"
      ]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "check": {
      "dependsOn": ["^build", "build"]
    },
    "lint": {}
  }
}
