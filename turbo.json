{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["scripts/source-hash.mjs", "scripts/build-id.mjs", "tsconfig.base.json"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "check": {
      "dependsOn": ["^build", "build"]
    },
    "lint": {}
  }
}
